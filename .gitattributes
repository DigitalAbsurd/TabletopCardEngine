# Line-ending normalization. Repository sources are CRLF (see .editorconfig).
* text=auto

*.cs        text eol=crlf
*.csproj    text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.sln       text eol=crlf
*.ps1       text eol=crlf
*.resx      text eol=crlf

*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.txt       text eol=lf
Dockerfile      text eol=lf
.dockerignore   text eol=lf
*.phhs      text eol=lf
*.json      text eol=lf

*.gz        binary
*.png       binary
eng/api-baseline/*.nupkg binary

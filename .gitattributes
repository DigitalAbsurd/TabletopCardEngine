# Нормализация окончаний строк. Исходники репозитория — CRLF (см. .editorconfig).
* text=auto

*.cs        text eol=crlf
*.csproj    text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.sln       text eol=crlf
*.ps1       text eol=crlf
*.resx      text eol=crlf

*.md        text eol=lf
*.phhs      text eol=lf

*.gz        binary

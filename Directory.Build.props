<Project>

  <!--
    Shared build settings for every project in the repository.
    Style rules live in .editorconfig; this file only enforces them.
  -->

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Label="Code analysis">
    <!-- IDExxxx style rules from .editorconfig are checked at build time, not just in the IDE. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- CAxxxx quality rules (Microsoft.CodeAnalysis.NetAnalyzers, shipped with the SDK). -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>

    <!-- The build fails on linter violations. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>

    <!--
      Targeted escape hatch for warnings unrelated to code style
      (e.g. NUxxxx from restore). Keep this list empty or short and
      justified; use .editorconfig for analysis rules, not NoWarn.
    -->
    <WarningsNotAsErrors></WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="Versioning">
    <!-- Versions come from git tags (v1.2.3, v1.2.3-preview.1) through MinVer; see docs/versioning.md. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
    <MinVerMinimumMajorMinor>1.0</MinVerMinimumMajorMinor>
  </PropertyGroup>

  <ItemGroup Label="Versioning">
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup Label="Package metadata">
    <!--
      Shared by the seven packages in TabletopCardEngine.Packages.slnf; each sets its own
      Description. Projects that are not packed ignore these. The license and the holder follow
      ADR-0001 and NOTICE.
    -->
    <Authors>Mikhail Khrapunov</Authors>
    <Company>Mikhail Khrapunov</Company>
    <Copyright>Copyright 2025-2026 Mikhail Khrapunov</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/DigitalAbsurd/TabletopCardEngine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DigitalAbsurd/TabletopCardEngine</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>poker;texas-holdem;holdem;no-limit;card-game;game-engine</PackageTags>
  </PropertyGroup>

  <PropertyGroup Label="SourceLink">
    <!--
      The SDK ships SourceLink for GitHub, so this needs no package reference. PublishRepositoryUrl
      writes the repository url into the nuspec next to the commit; ContinuousIntegrationBuild
      maps the source paths in the PDBs to /_/, and only on CI, where GitHub Actions sets
      GITHUB_ACTIONS, because mapped paths get in the way of local debugging.
    -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Label="Package metadata">
    <!-- ADR-0001: every package carries the project's NOTICE beside its README. -->
    <None Include="$(MSBuildThisFileDirectory)NOTICE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>

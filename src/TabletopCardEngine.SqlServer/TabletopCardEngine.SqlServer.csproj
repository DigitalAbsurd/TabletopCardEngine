<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Description>SQL Server provider for TabletopCardEngine, with the engine's schema migrations for Microsoft SQL Server.</Description>
    <!-- Public API documentation is mandatory: CS1591 -> error via TreatWarningsAsErrors. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Public API baseline">
    <!--
      The same gate as the core library, over this package's own baseline: dotnet pack fails on a
      removed or changed public member (CP0001, CP0002, ...). Changing the surface means re-packing
      the baseline in the same pull request: see docs/public-api.md.
    -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselinePath>$(MSBuildThisFileDirectory)../../eng/api-baseline/TabletopCardEngine.SqlServer.1.0.0-baseline.nupkg</PackageValidationBaselinePath>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The provider the migrations are generated for; the core package references no provider. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <!--
      Pinned above the 6.1.6 that EF Core SqlServer 10.0.12 asks for: 6.1.6 pulls in
      Microsoft.Identity.Client.Broker and with it Microsoft.Identity.Client.NativeInterop, which is
      under a proprietary licence outside the allowlist (ADR-0003). 7.x moved Azure/Entra
      authentication into a separate package, so none of that is resolved. Drop this pin once the
      EF Core provider depends on a SqlClient without the broker.
    -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- What dotnet ef needs to scaffold the migrations. Development only: it never flows to consumers. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TabletopCardEngine\TabletopCardEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

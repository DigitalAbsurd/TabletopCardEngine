<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Description>OpenTelemetry instrumentation for TabletopCardEngine: one call adds the engine's traces and metrics to a tracer or meter provider.</Description>
    <!-- Public API documentation is mandatory: CS1591 -> error via TreatWarningsAsErrors. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Public API baseline">
    <!--
      The same gate as the core library, over this package's own baseline: dotnet pack fails on a
      removed or changed public member (CP0001, CP0002, ...). Changing the surface means re-packing
      the baseline in the same pull request: see docs/public-api.md.
    -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselinePath>$(MSBuildThisFileDirectory)../../eng/api-baseline/TabletopCardEngine.OpenTelemetry.1.0.0-baseline.nupkg</PackageValidationBaselinePath>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The API only, never the SDK: TracerProviderBuilder, MeterProviderBuilder, AddSource and AddMeter live here. -->
    <PackageReference Include="OpenTelemetry.Api" Version="1.19.1" />
    <!-- IOpenTelemetryBuilder and the ConfigureOpenTelemetry*Provider methods for the builder extension. -->
    <PackageReference Include="OpenTelemetry.Api.ProviderBuilderExtensions" Version="1.19.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TabletopCardEngine\TabletopCardEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Description>No-Limit Texas Hold'em cash-game engine for .NET: betting rules, blinds, side pots and showdown, persisted through Entity Framework Core and driven by a single async command method. Add a provider package (Sqlite, PostgreSql, SqlServer or InMemory) for the database.</Description>
    <!-- Public API documentation is mandatory: CS1591 -> error via TreatWarningsAsErrors. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Public API baseline">
    <!--
      dotnet pack compares the public surface against the published 1.0.0 version on nuget.org
      and fails on a removed or changed member (CP0001, CP0002, ...). A break is a major version:
      see docs/public-api.md.
    -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.1.0</PackageValidationBaselineVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(AssemblyName).Tests" />
    <InternalsVisibleTo Include="$(AssemblyName).Demo" />
    <InternalsVisibleTo Include="$(AssemblyName).Demo.Tests" />
    <InternalsVisibleTo Include="$(AssemblyName).Sqlite" />
    <InternalsVisibleTo Include="$(AssemblyName).PostgreSql" />
    <InternalsVisibleTo Include="$(AssemblyName).SqlServer" />
    <InternalsVisibleTo Include="$(AssemblyName).AspNetCore" />
    <InternalsVisibleTo Include="$(AssemblyName).AspNetCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\PackResource.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>PackResource.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\PackResource.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>PackResource.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

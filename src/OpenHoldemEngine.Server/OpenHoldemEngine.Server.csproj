<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Generated only so that IDE0005 (unnecessary using) runs at build time; a host needs no API docs. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenHoldemEngine.AspNetCore\OpenHoldemEngine.AspNetCore.csproj" />
    <ProjectReference Include="..\OpenHoldemEngine.PostgreSql\OpenHoldemEngine.PostgreSql.csproj" />
    <ProjectReference Include="..\OpenHoldemEngine.Sqlite\OpenHoldemEngine.Sqlite.csproj" />
    <ProjectReference Include="..\OpenHoldemEngine.SqlServer\OpenHoldemEngine.SqlServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the tests use the internal top-level Program as WebApplicationFactory<Program>. -->
    <InternalsVisibleTo Include="OpenHoldemEngine.Server.Tests" />
  </ItemGroup>

</Project>

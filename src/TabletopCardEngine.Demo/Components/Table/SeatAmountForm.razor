@* The small form a seat opens to top up or rebuy: one amount, Confirm and Cancel. It takes the
   look of the Sit down panel and sits in the seat's own flow, so the seat grows to hold it rather
   than the form being laid over its neighbours. *@
<div class="seat-amount-form" role="group" aria-label="@($"{Title} {SeatName}")">
    <input class="seat-amount-input"
        type="number"
        min="0.01"
        step="0.01"
        aria-label="@($"{Title} amount for {SeatName}")"
        @bind="_amount"
        @bind:event="oninput" />
    <div class="seat-amount-buttons">
        <button type="button" class="seat-amount-confirm" disabled="@(_amount <= 0)" @onclick="ConfirmAsync">Confirm</button>
        <button type="button" class="seat-amount-cancel" @onclick="CancelAsync">Cancel</button>
    </div>
</div>

@code {
    /// <summary>The action the form performs, <c>Top up</c> or <c>Rebuy</c>; it names the form for assistive technology.</summary>
    [Parameter]
    public required string Title { get; set; }

    /// <summary>The name of the player the chips are for.</summary>
    [Parameter]
    public required string SeatName { get; set; }

    /// <summary>The amount the field starts with.</summary>
    [Parameter]
    public decimal InitialAmount { get; set; }

    /// <summary>Raised with the amount when Confirm is pressed.</summary>
    [Parameter]
    public EventCallback<decimal> OnConfirm { get; set; }

    /// <summary>Raised when Cancel is pressed.</summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    private decimal _amount;

    /// <inheritdoc />
    protected override void OnInitialized() => _amount = InitialAmount;

    private Task ConfirmAsync() => OnConfirm.InvokeAsync(_amount);

    private Task CancelAsync() => OnCancel.InvokeAsync();
}

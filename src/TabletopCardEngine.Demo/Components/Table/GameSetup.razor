@using AntDesign
@using TabletopCardEngine.Demo.Services
@using TabletopCardEngine.Holdem

<Card Title="Game Setup" Class="game-setup-card">
    <Space Direction="@DirectionVHType.Vertical" Style="width: 100%;">
        <!-- Error Messages -->
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <Alert
                Message="Error"
                Description="@_errorMessage"
                Type="@AlertType.Error"
                Closable="true"
                OnClose="@ClearErrorMessage"
                ShowIcon="true" />
        }

        @* Captions sit above their fields and every field is as wide as its own column, so no
           caption can run into the input beside it. *@
        <div class="game-options">
            <div class="form-group">
                <label for="setup-table-format">Table format</label>
                <Select
                    Id="setup-table-format"
                    Value="@_tableFormat"
                    ValueChanged="@OnTableFormatChangedAsync"
                    Disabled="@_isLoading"
                    Style="width: 100%;"
                    TItemValue="HoldemTableFormat"
                    TItem="HoldemTableFormat">
                    <SelectOptions>
                        <SelectOption TItemValue="HoldemTableFormat" TItem="HoldemTableFormat" Value="@HoldemTableFormat.HeadsUp" Label="Heads-Up (2-Max)" />
                        <SelectOption TItemValue="HoldemTableFormat" TItem="HoldemTableFormat" Value="@HoldemTableFormat.SixMax" Label="6-Max" />
                        <SelectOption TItemValue="HoldemTableFormat" TItem="HoldemTableFormat" Value="@HoldemTableFormat.FullRing" Label="Full Ring" />
                    </SelectOptions>
                </Select>
            </div>

            <div class="form-group">
                <label for="setup-betting-structure">Betting structure</label>
                <Select
                    Id="setup-betting-structure"
                    @bind-Value="_bettingStructure"
                    Disabled="@_isLoading"
                    Style="width: 100%;"
                    TItemValue="BettingStructure"
                    TItem="BettingStructure">
                    <SelectOptions>
                        <SelectOption TItemValue="BettingStructure" TItem="BettingStructure" Value="@BettingStructure.NoLimit" Label="@BettingStructureLabels.GetLabel(BettingStructure.NoLimit)" />
                        <SelectOption TItemValue="BettingStructure" TItem="BettingStructure" Value="@BettingStructure.PotLimit" Label="@BettingStructureLabels.GetLabel(BettingStructure.PotLimit)" />
                        <SelectOption TItemValue="BettingStructure" TItem="BettingStructure" Value="@BettingStructure.FixedLimit" Label="@BettingStructureLabels.GetLabel(BettingStructure.FixedLimit)" />
                    </SelectOptions>
                </Select>
            </div>

            @if (_bettingStructure == BettingStructure.FixedLimit)
            {
                <div class="form-group">
                    <label for="setup-raise-cap">Raise cap</label>
                    <input
                        id="setup-raise-cap"
                        type="number"
                        step="1"
                        min="1"
                        disabled="@(_isLoading || _noRaiseCap)"
                        placeholder="No cap"
                        @bind="_raiseCap"
                        class="setup-input" />
                </div>

                <div class="form-group">
                    <label for="setup-no-raise-cap">No cap</label>
                    <input
                        id="setup-no-raise-cap"
                        type="checkbox"
                        disabled="@_isLoading"
                        @bind="_noRaiseCap" />
                </div>
            }

            <div class="form-group">
                <label for="setup-max-players">Max Players</label>
                <Select
                    Id="setup-max-players"
                    Value="@_maxPlayers"
                    ValueChanged="@OnMaxPlayersChangedAsync"
                    Disabled="@_isLoading"
                    Style="width: 100%;"
                    TItemValue="int"
                    TItem="int">
                    <SelectOptions>
                        @if (_tableFormat == HoldemTableFormat.HeadsUp)
                        {
                            <SelectOption TItemValue="int" TItem="int" Value="2" Label="2" />
                        }
                        else if (_tableFormat == HoldemTableFormat.SixMax)
                        {
                            <SelectOption TItemValue="int" TItem="int" Value="2" Label="2" />
                            <SelectOption TItemValue="int" TItem="int" Value="3" Label="3" />
                            <SelectOption TItemValue="int" TItem="int" Value="4" Label="4" />
                            <SelectOption TItemValue="int" TItem="int" Value="5" Label="5" />
                            <SelectOption TItemValue="int" TItem="int" Value="6" Label="6" />
                        }
                        else if (_tableFormat == HoldemTableFormat.FullRing)
                        {
                            <SelectOption TItemValue="int" TItem="int" Value="7" Label="7" />
                            <SelectOption TItemValue="int" TItem="int" Value="8" Label="8" />
                            <SelectOption TItemValue="int" TItem="int" Value="9" Label="9" />
                            <SelectOption TItemValue="int" TItem="int" Value="10" Label="10" />
                        }
                    </SelectOptions>
                </Select>
            </div>

            <div class="form-group">
                <label for="setup-small-blind">Small Blind</label>
                <input
                    id="setup-small-blind"
                    type="number"
                    step="0.01"
                    min="0.01"
                    disabled="@_isLoading"
                    placeholder="Small blind amount"
                    @bind="_smallBlind"
                    class="setup-input" />
            </div>

            <div class="form-group">
                <label for="setup-allow-top-up">Allow top-up</label>
                <input
                    id="setup-allow-top-up"
                    type="checkbox"
                    disabled="@_isLoading"
                    @bind="_allowTopUp" />
            </div>

            <div class="form-group">
                <label for="setup-allow-rebuy">Allow rebuy</label>
                <input
                    id="setup-allow-rebuy"
                    type="checkbox"
                    disabled="@_isLoading"
                    @bind="_allowRebuy" />
            </div>

            <div class="form-group">
                <label for="setup-max-rebuys">Max rebuys</label>
                <input
                    id="setup-max-rebuys"
                    type="number"
                    step="1"
                    min="0"
                    disabled="@(_isLoading || !_allowRebuy)"
                    placeholder="Unlimited"
                    @bind="_maxRebuys"
                    class="setup-input" />
            </div>

            <div class="form-group">
                <label for="setup-min-buy-in">Min buy-in</label>
                <input
                    id="setup-min-buy-in"
                    type="number"
                    step="0.01"
                    disabled="@_isLoading"
                    placeholder="No limit"
                    @bind="_minBuyIn"
                    class="setup-input" />
            </div>

            <div class="form-group">
                <label for="setup-max-buy-in">Max buy-in</label>
                <input
                    id="setup-max-buy-in"
                    type="number"
                    step="0.01"
                    disabled="@_isLoading"
                    placeholder="No limit"
                    @bind="_maxBuyIn"
                    class="setup-input" />
            </div>

            <div class="form-group">
                <label>Big Blind</label>
                <div class="big-blind-value">
                    <span class="big-blind-display">@(_smallBlind * 2)</span>
                    <span class="field-hint">(auto, 2x small blind)</span>
                </div>
            </div>

            <div class="form-group">
                <label for="setup-dealer-seat">Dealer Seat (1-based)</label>
                <input
                    id="setup-dealer-seat"
                    type="number"
                    min="1"
                    max="@_maxPlayers"
                    disabled="@_isLoading"
                    placeholder="Initial dealer seat"
                    value="@_dealerSeat"
                    @onchange="OnDealerSeatChangedAsync"
                    class="setup-input" />
            </div>

            @* The blind schedule's inputs sit in this grid. The demo only builds the options; the
               engine works the levels out and answers for a schedule it refuses. *@
            <div class="form-group">
                <label for="setup-increase-blinds">Increase blinds</label>
                <input
                    id="setup-increase-blinds"
                    type="checkbox"
                    disabled="@_isLoading"
                    @bind="_increaseBlinds" />
            </div>

            @if (_increaseBlinds)
            {
                <div class="form-group">
                    <label for="setup-increase-every-hands">Every N hands</label>
                    <input
                        id="setup-increase-every-hands"
                        type="number"
                        step="1"
                        min="1"
                        disabled="@_isLoading"
                        placeholder="Off"
                        @bind="_increaseEveryHands"
                        class="setup-input" />
                </div>

                <div class="form-group">
                    <label for="setup-increase-on-elimination">On each elimination</label>
                    <input
                        id="setup-increase-on-elimination"
                        type="checkbox"
                        disabled="@_isLoading"
                        @bind="_increaseOnElimination" />
                </div>

                <div class="form-group">
                    <span class="blind-caption">Player thresholds</span>
                    <div class="threshold-list">
                        @for (var threshold = 2; threshold < _maxPlayers; threshold++)
                        {
                            var value = threshold;
                            <span class="threshold-option">
                                <input
                                    id="setup-threshold-@value"
                                    type="checkbox"
                                    class="setup-threshold"
                                    disabled="@_isLoading"
                                    checked="@_playerThresholds.Contains(value)"
                                    @onchange="@(e => OnThresholdChanged(value, e.Value is true))" />
                                <label for="setup-threshold-@value">@value</label>
                            </span>
                        }
                    </div>
                </div>

                <div class="form-group">
                    <span class="blind-caption">Mode</span>
                    <div class="threshold-list">
                        <span class="threshold-option">
                            <input
                                id="setup-mode-multiplier"
                                type="radio"
                                name="setup-blind-mode"
                                disabled="@_isLoading"
                                checked="@(_blindMode == BlindIncreaseMode.Multiplier)"
                                @onchange="@(() => _blindMode = BlindIncreaseMode.Multiplier)" />
                            <label for="setup-mode-multiplier">Multiplier</label>
                        </span>
                        <span class="threshold-option">
                            <input
                                id="setup-mode-levels"
                                type="radio"
                                name="setup-blind-mode"
                                disabled="@_isLoading"
                                checked="@(_blindMode == BlindIncreaseMode.Levels)"
                                @onchange="@(() => _blindMode = BlindIncreaseMode.Levels)" />
                            <label for="setup-mode-levels">Levels</label>
                        </span>
                    </div>
                </div>

                @if (_blindMode == BlindIncreaseMode.Multiplier)
                {
                    <div class="form-group">
                        <label for="setup-multiplier">Multiplier</label>
                        <input
                            id="setup-multiplier"
                            type="number"
                            step="0.01"
                            disabled="@_isLoading"
                            @bind="_multiplier"
                            class="setup-input" />
                    </div>

                    <div class="form-group">
                        <label for="setup-max-small-blind">Max small blind</label>
                        <input
                            id="setup-max-small-blind"
                            type="number"
                            step="0.01"
                            disabled="@_isLoading"
                            placeholder="No cap"
                            @bind="_maxSmallBlind"
                            class="setup-input" />
                    </div>
                }
                else
                {
                    <div class="form-group">
                        <label for="setup-small-blind-levels">Small blind levels</label>
                        <input
                            id="setup-small-blind-levels"
                            type="text"
                            disabled="@_isLoading"
                            placeholder="2, 3, 5, 10"
                            @bind="_smallBlindLevels"
                            class="setup-input" />
                        @if (!string.IsNullOrEmpty(_levelsMessage))
                        {
                            <span class="field-message" role="alert">@_levelsMessage</span>
                        }
                    </div>
                }
            }
        </div>

        <!-- Players List -->
        <div class="players-section">
            <h3>Players</h3>
            @* One grid: a caption row, then one row per player, so Name, Seat and Buy-in line up in
               columns wide enough for their inputs. *@
            <div class="players-grid">
                <span class="players-caption">Name</span>
                <span class="players-caption">Seat</span>
                <span class="players-caption">Buy-in</span>
                <span class="players-caption" aria-hidden="true"></span>

                @for (int i = 0; i < _players.Count; i++)
                {
                    var index = i;
                    var player = _players[index];
                    <div class="player-row">
                        <input
                            type="text"
                            disabled="@_isLoading"
                            placeholder="Player name"
                            aria-label="Player name"
                            @bind="player.Name"
                            class="setup-input" />
                        <input
                            type="number"
                            min="1"
                            max="@_maxPlayers"
                            disabled="@_isLoading"
                            aria-label="Seat"
                            @bind="player.SeatNo"
                            class="setup-input" />
                        <input
                            type="number"
                            step="1"
                            min="0.01"
                            disabled="@_isLoading"
                            placeholder="Buy-in"
                            aria-label="Buy-in"
                            @bind="player.BuyInAmount"
                            class="setup-input" />
                        <Button
                            Type="@ButtonType.Text"
                            Danger
                            OnClick="@(() => RemovePlayer(index))"
                            Disabled="@_isLoading">
                            Remove
                        </Button>
                    </div>
                }
            </div>

            <Button
                Type="@ButtonType.Dashed"
                OnClick="@AddPlayer"
                Disabled="@(_isLoading || _players.Count >= _maxPlayers)"
                Class="add-player-btn"
                Block>
                + Add Player (max @_maxPlayers)
            </Button>
        </div>
    </Space>
</Card>

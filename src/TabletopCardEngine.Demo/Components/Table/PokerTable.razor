@using TabletopCardEngine.Holdem.Dto
@using TabletopCardEngine.Holdem
@using DataCard = TabletopCardEngine.Card
@using TabletopCardEngine.Demo.Services

@* The whole game area in one piece: the seats around the board, the street between the top row
   and the board, and the action bar along the bottom. The session's settings are in the page
   header, so every pixel of the table's height goes to the hand. Nothing about the running hand
   is shown anywhere else on the page, so nothing here is shown twice. *@
<div class="poker-table">
    @if (Hand is not null)
    {
        <div class="table-seats-row">
            @foreach (var seat in TopRowSeats(Hand))
            {
                <Seat
                    SeatData="seat"
                    IsDealer="@(seat.SeatNo == Hand.DealerSeatNo)"
                    IsSmallBlind="@(seat.SeatNo == Hand.SmallBlindSeatNo)"
                    IsBigBlind="@(seat.SeatNo == Hand.BigBlindSeatNo)"
                    IsActing="@(seat.SeatNo == Hand.NextPlayerSeatNo)"
                    HighlightedCards="@SeatHighlight(seat)" />
            }
        </div>

        <StreetIndicator Street="@Hand.Street" />
    }

    <div class="table-center">
        <div class="community-cards">
            @if (Hand?.CommunityCards is not null && Hand.CommunityCards.Count > 0)
            {
                @foreach (var card in Hand.CommunityCards)
                {
                    <PlayingCard Card="card" IsHighlighted="@HighlightedCards.Contains(card)" />
                }
            }
            else
            {
                <div class="empty-board">No community cards</div>
            }
        </div>

        @if (Hand is not null)
        {
            <div class="pot-info">
                <div class="pot-row">
                    <span class="pot-label">Pot:</span>
                    <span class="pot-value">@AmountFormat.Format(Hand.Pot + Hand.StreetPot)</span>
                </div>
                <div class="pot-breakdown">
                    <span class="pot-small">Prior: @AmountFormat.Format(Hand.Pot)</span>
                    <span class="pot-small">Street: @AmountFormat.Format(Hand.StreetPot)</span>
                    <span class="pot-small active-count">Active: @Hand.Seats.Count(s => s.IsActive)/@Hand.Seats.Count</span>
                </div>
            </div>

            @if (IsHandFinished)
            {
                <div class="hand-results">
                    @foreach (var seat in Hand.Seats.Where(s => s.HandResult is not null).OrderBy(s => s.SeatNo))
                    {
                        var net = seat.HandResult!.Net;
                        var seatNo = seat.SeatNo;
                        <div class="hand-result @ResultClass(net) @(seatNo == FocusedSeatNo ? "hand-result-selected" : "")"
                             data-seat-no="@seatNo"
                             role="button"
                             tabindex="0"
                             aria-pressed="@(seatNo == _pinnedSeatNo ? "true" : "false")"
                             title="Hover to show the cards of this hand, click to keep them shown"
                             @onmouseenter="@(() => _hoveredSeatNo = seatNo)"
                             @onmouseleave="@(() => _hoveredSeatNo = 0)"
                             @onfocus="@(() => _hoveredSeatNo = seatNo)"
                             @onblur="@(() => _hoveredSeatNo = 0)"
                             @onclick="@(() => TogglePin(seatNo))">
                            <span class="hand-result-name">@seat.Name</span>
                            <span class="hand-result-rank">@FormatRankType(seat.HandResult.RankType)</span>
                            <span class="hand-result-net">@(net > 0 ? "+" : "")@AmountFormat.Format(net)</span>
                        </div>
                    }
                </div>
            }
        }
    </div>

    @if (Hand is not null)
    {
        <div class="table-seats-row">
            @foreach (var seat in BottomRowSeats(Hand))
            {
                <Seat
                    SeatData="seat"
                    IsDealer="@(seat.SeatNo == Hand.DealerSeatNo)"
                    IsSmallBlind="@(seat.SeatNo == Hand.SmallBlindSeatNo)"
                    IsBigBlind="@(seat.SeatNo == Hand.BigBlindSeatNo)"
                    IsActing="@(seat.SeatNo == Hand.NextPlayerSeatNo)"
                    HighlightedCards="@SeatHighlight(seat)" />
            }
        </div>

        <ActionPanel
            HandData="@Hand"
            RaiseStep="@SmallBlind"
            OnNextHand="@OnNextHand" />
    }
</div>

@code {
    /// <summary>The game to display, or null before the first successful engine call.</summary>
    [Parameter]
    public GameData? GameData { get; set; }

    /// <summary>Raised from the action bar once a hand is finished, to deal the next one.</summary>
    [Parameter]
    public EventCallback OnNextHand { get; set; }

    /// <summary>
    /// The dealt hand, or null. GameData.HandData is null
    /// between CreateGame and the first StartGame, and hand 0 is that same placeholder.
    /// </summary>
    private HandData? Hand => GameData?.HandData is { No: > 0 } hand ? hand : null;

    /// <summary>The smallest chip on the table, and so one step of the raise amount.</summary>
    private decimal SmallBlind => GameData?.Options.InitialSmallBlind ?? 0m;

    private bool IsHandFinished => Hand?.Street == Street.Finished;

    private static readonly IReadOnlySet<DataCard> _noCards = new HashSet<DataCard>();

    /// <summary>The seat whose result chip is under the pointer or has keyboard focus; 0 for none.</summary>
    private byte _hoveredSeatNo;

    /// <summary>The seat whose result chip was clicked to keep its cards lit; 0 for none.</summary>
    private byte _pinnedSeatNo;

    /// <summary>The hand the pin belongs to, so a new hand starts with nothing lit.</summary>
    private int _pinnedHandNo;

    /// <summary>A hover wins over the pin, so any chip can be previewed while another is pinned.</summary>
    private byte FocusedSeatNo => !IsHandFinished ? (byte)0 : _hoveredSeatNo != 0 ? _hoveredSeatNo : _pinnedSeatNo;

    /// <summary>The cards of the focused seat's combination, in its hole and on the board.</summary>
    private IReadOnlySet<DataCard> HighlightedCards
    {
        get
        {
            var seat = Hand?.Seats.FirstOrDefault(s => s.SeatNo == FocusedSeatNo);
            return seat?.HandResult is null || seat.Hole is null
                ? _noCards
                : HandCombination.CombinationCards(seat.Hole, Hand!.CommunityCards, seat.HandResult.RankType);
        }
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (!IsHandFinished || Hand!.No != _pinnedHandNo)
        {
            _hoveredSeatNo = 0;
            _pinnedSeatNo = 0;
            _pinnedHandNo = Hand?.No ?? 0;
        }
    }

    private void TogglePin(byte seatNo) => _pinnedSeatNo = _pinnedSeatNo == seatNo ? (byte)0 : seatNo;

    private IReadOnlySet<DataCard>? SeatHighlight(SeatData seat) => seat.SeatNo == FocusedSeatNo ? HighlightedCards : null;

    /// <summary>
    /// The top row, read left to right: the first half of the seats (rounded up), ascending by seat
    /// number. Paired with <see cref="BottomRowSeats"/>, reading the two rows in order is clockwise.
    /// </summary>
    private static IEnumerable<SeatData> TopRowSeats(HandData handData)
        => handData.Seats.Take(TopRowCount(handData));

    /// <summary>
    /// The bottom row, read left to right: the remaining seats, descending by seat number, so the seat
    /// after the top-right one is the next one clockwise rather than a jump back across the table.
    /// </summary>
    private static IEnumerable<SeatData> BottomRowSeats(HandData handData)
        => handData.Seats.Skip(TopRowCount(handData)).Reverse();

    private static int TopRowCount(HandData handData) => (handData.Seats.Count + 1) / 2;

    private static string ResultClass(decimal net)
        => net > 0 ? "result-winner" : net < 0 ? "result-loser" : "result-neutral";

    private static string FormatRankType(HandRankType rankType)
    {
        return rankType switch
        {
            HandRankType.HighCard => "High Card",
            HandRankType.Pair => "Pair",
            HandRankType.TwoPair => "Two Pair",
            HandRankType.Trips => "Three of a Kind",
            HandRankType.Straight => "Straight",
            HandRankType.Flush => "Flush",
            HandRankType.FullHouse => "Full House",
            HandRankType.FourOfAKind => "Four of a Kind",
            HandRankType.StraightFlush => "Straight Flush",
            _ => "No Hand"
        };
    }
}

@using TabletopCardEngine.Holdem.Dto
@using TabletopCardEngine.Holdem
@using DataCard = TabletopCardEngine.Card
@using TabletopCardEngine.Demo.Services

@* The whole game area in one piece: the seats around the board, the action bar along the bottom, and
   between the two seat rows one band of three columns: the street (vertical) on the left, the board
   and pot in the middle and, once the hand is finished, the result chips (one per line) on the right,
   on felt that is otherwise empty. The session's settings are in the page
   header, so every pixel of the table's height goes to the hand. Nothing about the running hand
   is shown anywhere else on the page, so nothing here is shown twice. *@
<div class="poker-table">
    @if (Hand is not null)
    {
        <div class="table-seats-row">
            @foreach (var seatNo in TopRowSeatNos())
            {
                @if (SeatAt(Hand, seatNo) is { } seat)
                {
                    <Seat
                        SeatData="seat"
                        CanStandUp="@CanSeat"
                        Queued="@QueuedAt(seat.SeatNo)"
                        OnQueueJoin="@OnQueueJoin"
                        OnUnqueueJoin="@OnUnqueueJoin"
                        OnStandUp="@OnStandUp"
                        Options="@GameData?.Options"
                        OnTopUp="@OnTopUp"
                        OnKick="@OnKick"
                        AllowKick="@(!IsTournamentTable)"
                        IsDealer="@(seat.SeatNo == Hand.DealerSeatNo)"
                        IsSmallBlind="@(seat.SeatNo == Hand.SmallBlindSeatNo)"
                        IsBigBlind="@(seat.SeatNo == Hand.BigBlindSeatNo)"
                        IsActing="@(seat.SeatNo == Hand.NextPlayerSeatNo)"
                        HighlightedCards="@SeatHighlight(seat)"
                        IsHandFinished="@IsHandFinished" />
                }
                else
                {
                    <EmptySeat
                        SeatNo="seatNo"
                        CanSitDown="@CanSeat"
                        Queued="@QueuedAt(seatNo)"
                        OnQueueJoin="@OnQueueJoin"
                        OnUnqueueJoin="@OnUnqueueJoin" />
                }
            }
        </div>
    }

    <div class="table-band">
        <div class="band-street">
            @if (Hand is not null)
            {
                <StreetIndicator Street="@Hand.Street" />
            }
        </div>

        <div class="table-center">
            <div class="community-cards">
                @{
                    var dealt = Hand?.CommunityCards ?? [];
                }
                @foreach (var card in dealt)
                {
                    <PlayingCard Card="card" IsHighlighted="@HighlightedCards.Contains(card)" />
                }
                @for (var i = dealt.Count; i < BoardSlotCount; i++)
                {
                    <div class="board-slot" aria-hidden="true"></div>
                }
            </div>

            @if (Hand is not null)
            {
                <div class="pot-info">
                    <div class="pot-row">
                        <span class="pot-label">Pot:</span>
                        <span class="pot-value">@AmountFormat.Format(Hand.Pot + Hand.StreetPot)</span>
                    </div>
                    <div class="pot-breakdown">
                        <span class="pot-small blinds-value">Blinds @AmountFormat.Format(Hand.SmallBlind)/@AmountFormat.Format(Hand.BigBlind)@AnteSuffix@(HasBlindSchedule ? $" · Level {Hand.BlindLevel + 1}" : "")</span>
                        @if (BlindLevelRaised)
                        {
                            <span class="blind-raised" title="The blinds rose for this hand">Blinds up</span>
                        }
                        <span class="pot-small">Prior: @AmountFormat.Format(Hand.Pot)</span>
                        <span class="pot-small">Street: @AmountFormat.Format(Hand.StreetPot)</span>
                        <span class="pot-small active-count">Active: @Hand.Seats.Count(s => s.IsActive)/@Hand.Seats.Count</span>
                    </div>
                </div>
            }
        </div>

        <div class="band-results">
            @if (IsHandFinished && Hand is not null)
            {
                <div class="hand-results">
                    @foreach (var seat in Hand.Seats.Where(s => s.HandResult is not null).OrderBy(s => s.SeatNo))
                    {
                        var net = seat.HandResult!.Net;
                        var seatNo = seat.SeatNo;
                        <div class="hand-result @ResultClass(net) @(seatNo == FocusedSeatNo ? "hand-result-selected" : "")"
                             data-seat-no="@seatNo"
                             role="button"
                             tabindex="0"
                             aria-pressed="@(seatNo == _pinnedSeatNo ? "true" : "false")"
                             title="Hover to show the cards of this hand, click to keep them shown"
                             @onmouseenter="@(() => _hoveredSeatNo = seatNo)"
                             @onmouseleave="@(() => _hoveredSeatNo = 0)"
                             @onfocus="@(() => _hoveredSeatNo = seatNo)"
                             @onblur="@(() => _hoveredSeatNo = 0)"
                             @onclick="@(() => TogglePin(seatNo))">
                            <span class="hand-result-name" title="@seat.Name">@seat.Name</span>
                            <span class="hand-result-rank">@FormatRankType(seat.HandResult.RankType)</span>
                            <span class="hand-result-net">@(net > 0 ? "+" : "")@AmountFormat.Format(net)</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    @if (Hand is not null)
    {
        <div class="table-seats-row">
            @foreach (var seatNo in BottomRowSeatNos())
            {
                @if (SeatAt(Hand, seatNo) is { } seat)
                {
                    <Seat
                        SeatData="seat"
                        CanStandUp="@CanSeat"
                        Queued="@QueuedAt(seat.SeatNo)"
                        OnQueueJoin="@OnQueueJoin"
                        OnUnqueueJoin="@OnUnqueueJoin"
                        OnStandUp="@OnStandUp"
                        Options="@GameData?.Options"
                        OnTopUp="@OnTopUp"
                        OnKick="@OnKick"
                        AllowKick="@(!IsTournamentTable)"
                        IsDealer="@(seat.SeatNo == Hand.DealerSeatNo)"
                        IsSmallBlind="@(seat.SeatNo == Hand.SmallBlindSeatNo)"
                        IsBigBlind="@(seat.SeatNo == Hand.BigBlindSeatNo)"
                        IsActing="@(seat.SeatNo == Hand.NextPlayerSeatNo)"
                        HighlightedCards="@SeatHighlight(seat)"
                        IsHandFinished="@IsHandFinished" />
                }
                else
                {
                    <EmptySeat
                        SeatNo="seatNo"
                        CanSitDown="@CanSeat"
                        Queued="@QueuedAt(seatNo)"
                        OnQueueJoin="@OnQueueJoin"
                        OnUnqueueJoin="@OnUnqueueJoin" />
                }
            }
        </div>

        <ActionPanel
            HandData="@Hand"
            RaiseStep="@SmallBlind"
            BettingStructure="@(GameData?.Options.BettingStructure ?? BettingStructure.NoLimit)"
            CanDealNext="@CanDealNext"
            OnNextHand="@OnNextHand" />
    }
</div>

@code {
    /// <summary>The game to display, or null before the first successful engine call.</summary>
    [Parameter]
    public GameData? GameData { get; set; }

    /// <summary>
    /// Whether the game is a table of a tournament. The tournament owns who sits there, so the seat controls
    /// the engine refuses on such a table (stand up, top-up, kick, join) are not offered.
    /// </summary>
    [Parameter]
    public bool IsTournamentTable { get; set; }

    /// <summary>Whether a finished hand offers Next Hand; a finished tournament switches it off.</summary>
    [Parameter]
    public bool CanDealNext { get; set; } = true;

    /// <summary>Raised from the action bar once a hand is finished, to deal the next one.</summary>
    [Parameter]
    public EventCallback OnNextHand { get; set; }

    /// <summary>The players queued to sit down with the next hand.</summary>
    [Parameter]
    public IReadOnlyList<PlayerJoinData> PendingJoins { get; set; } = [];

    /// <summary>Raised with a player the visitor queues to sit down with the next hand.</summary>
    [Parameter]
    public EventCallback<PlayerJoinData> OnQueueJoin { get; set; }

    /// <summary>Raised with the seat of a queued player the visitor takes back out.</summary>
    [Parameter]
    public EventCallback<byte> OnUnqueueJoin { get; set; }

    /// <summary>Raised with the seat number when the visitor stands a player up.</summary>
    [Parameter]
    public EventCallback<byte> OnStandUp { get; set; }

    /// <summary>Raised with the seat number when the visitor kicks a player, during a hand or between hands.</summary>
    [Parameter]
    public EventCallback<byte> OnKick { get; set; }

    /// <summary>Raised with the seat number and the chips when the visitor tops a seat up or rebuys it.</summary>
    [Parameter]
    public EventCallback<(byte SeatNo, decimal Amount)> OnTopUp { get; set; }

    /// <summary>
    /// Whether players may sit down or stand up: only between hands, of a game that is not finished.
    /// </summary>
    private bool CanSeat => IsHandFinished && GameData is { IsFinished: false } && !IsTournamentTable;

    /// <summary>
    /// The dealt hand, or null. GameData.HandData is null
    /// between CreateGame and the first StartGame, and hand 0 is that same placeholder.
    /// </summary>
    private HandData? Hand => GameData?.HandData is { No: > 0 } hand ? hand : null;

    /// <summary>The smallest chip on the table, and so one step of the raise amount.</summary>
    private decimal SmallBlind => GameData?.Options.InitialSmallBlind ?? 0m;

    /// <summary>
    /// The ante of the dealt hand, as the blinds line carries it: the hand's own figure, because a blind
    /// schedule scales it, and the type from the game's options. Empty when the hand has none.
    /// </summary>
    private string AnteSuffix => Hand is { Ante: > 0 } hand
        ? $" · {(GameData?.Options.AnteType == AnteType.BigBlind ? "BB ante" : "Ante")} {AmountFormat.Format(hand.Ante)}"
        : "";

    /// <summary>Whether the game has a blind schedule: only then does the level mean anything to show.</summary>
    private bool HasBlindSchedule => GameData?.Options.BlindSchedule is not null;

    /// <summary>The game the blind level was last tracked for, so a new game starts with no previous level.</summary>
    private Guid _levelGameId;

    /// <summary>The hand whose level is held in <see cref="_shownLevel"/>.</summary>
    private int _levelHandNo;

    /// <summary>The level of the hand the table shows now (0-based, as the engine has it).</summary>
    private int _shownLevel;

    /// <summary>The level of the hand the table showed before it, or null when this is the first hand shown.</summary>
    private int? _previousLevel;

    /// <summary>True on the first hand of a higher level than the hand shown before it, and only there.</summary>
    private bool BlindLevelRaised => Hand is not null && _previousLevel is { } previous && Hand.BlindLevel > previous;

    private bool IsHandFinished => Hand?.Street == Street.Finished;

    /// <summary>Community cards in a full board; the cards not dealt yet show as empty slots.</summary>
    private const int BoardSlotCount = 5;

    private static readonly IReadOnlySet<DataCard> _noCards = new HashSet<DataCard>();

    /// <summary>The seat whose result chip is under the pointer or has keyboard focus; 0 for none.</summary>
    private byte _hoveredSeatNo;

    /// <summary>The seat whose result chip was clicked to keep its cards lit; 0 for none.</summary>
    private byte _pinnedSeatNo;

    /// <summary>The hand the pin belongs to, so a new hand starts with nothing lit.</summary>
    private int _pinnedHandNo;

    /// <summary>A hover wins over the pin, so any chip can be previewed while another is pinned.</summary>
    private byte FocusedSeatNo => !IsHandFinished ? (byte)0 : _hoveredSeatNo != 0 ? _hoveredSeatNo : _pinnedSeatNo;

    /// <summary>The cards of the focused seat's combination, in its hole and on the board.</summary>
    private IReadOnlySet<DataCard> HighlightedCards
    {
        get
        {
            var seat = Hand?.Seats.FirstOrDefault(s => s.SeatNo == FocusedSeatNo);
            return seat?.HandResult is null || seat.Hole is null
                ? _noCards
                : HandCombination.CombinationCards(seat.Hole, Hand!.CommunityCards, seat.HandResult.RankType);
        }
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        TrackBlindLevel();
        if (!IsHandFinished || Hand!.No != _pinnedHandNo)
        {
            _hoveredSeatNo = 0;
            _pinnedSeatNo = 0;
            _pinnedHandNo = Hand?.No ?? 0;
        }
    }

    /// <summary>
    /// Remembers the level of the hand shown before the current one. It moves on only when the hand
    /// number changes, so a re-render within one hand keeps the marker and the next hand clears it.
    /// </summary>
    private void TrackBlindLevel()
    {
        if (Hand is null)
        {
            return;
        }

        var gameId = GameData!.GameId;
        if (gameId != _levelGameId)
        {
            _levelGameId = gameId;
            _previousLevel = null;
            _levelHandNo = 0;
        }

        if (Hand.No != _levelHandNo)
        {
            _previousLevel = _levelHandNo == 0 ? null : _shownLevel;
            _levelHandNo = Hand.No;
            _shownLevel = Hand.BlindLevel;
        }
    }

    private void TogglePin(byte seatNo) => _pinnedSeatNo = _pinnedSeatNo == seatNo ? (byte)0 : seatNo;

    private IReadOnlySet<DataCard>? SeatHighlight(SeatData seat) => seat.SeatNo == FocusedSeatNo ? HighlightedCards : null;

    /// <summary>
    /// The seat numbers of the top row, read left to right: the first half of the table's positions
    /// (rounded up), ascending. They come from the table's size, not from who is seated, so a free
    /// seat keeps its place and the seats around it stay where they are. Paired with
    /// <see cref="BottomRowSeatNos"/>, reading the two rows in order is clockwise.
    /// </summary>
    private IEnumerable<byte> TopRowSeatNos() => Enumerable.Range(1, TopRowCount).Select(n => (byte)n);

    /// <summary>
    /// The seat numbers of the bottom row, read left to right: the remaining positions, descending, so
    /// the seat after the top-right one is the next one clockwise rather than a jump back across the table.
    /// </summary>
    private IEnumerable<byte> BottomRowSeatNos() => Enumerable.Range(TopRowCount + 1, PositionCount - TopRowCount).Reverse().Select(n => (byte)n);

    /// <summary>
    /// How many positions the table draws: the game's seat count, or the dealt seats when that is more
    /// (never in practice, but a seat must not be dropped from the table).
    /// </summary>
    private int PositionCount => Math.Max(GameData?.Options.MaxPlayersCount ?? 0, Hand?.Seats.Max(s => (int?)s.SeatNo) ?? 0);

    private int TopRowCount => (PositionCount + 1) / 2;

    /// <summary>The dealt seat with this number, or null when the position is free.</summary>
    private static SeatData? SeatAt(HandData handData, byte seatNo) => handData.Seats.FirstOrDefault(s => s.SeatNo == seatNo);

    /// <summary>The player queued to sit down at this position with the next hand, or null for none.</summary>
    private PlayerJoinData? QueuedAt(byte seatNo) => PendingJoins.FirstOrDefault(p => p.SeatNo == seatNo);

    private static string ResultClass(decimal net)
        => net > 0 ? "result-winner" : net < 0 ? "result-loser" : "result-neutral";

    private static string FormatRankType(HandRankType rankType)
    {
        return rankType switch
        {
            HandRankType.HighCard => "High Card",
            HandRankType.Pair => "Pair",
            HandRankType.TwoPair => "Two Pair",
            HandRankType.Trips => "Three of a Kind",
            HandRankType.Straight => "Straight",
            HandRankType.Flush => "Flush",
            HandRankType.FullHouse => "Full House",
            HandRankType.FourOfAKind => "Four of a Kind",
            HandRankType.StraightFlush => "Straight Flush",
            _ => "No Hand"
        };
    }
}

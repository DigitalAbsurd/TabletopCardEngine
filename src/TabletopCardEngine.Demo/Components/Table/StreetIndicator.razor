@using AntDesign
@using TabletopCardEngine.Holdem

@* The table's only statement of which street is being played, so the centre and the summary never
   repeat it. Styles live in app.css: Steps is AntDesign markup, which a scoped stylesheet cannot
   reach (fact 22). *@
<div class="street-indicator">
    <Steps Size="small" Current="@CurrentIndex" Class="street-steps">
        @foreach (var title in _stepTitles)
        {
            <Step Title="@title" />
        }
    </Steps>
</div>

@code {
    /// <summary>The current street to display.</summary>
    [Parameter]
    public Street Street { get; set; } = Street.PreFlop;

    private static readonly string[] _stepTitles = ["Pre-Flop", "Flop", "Turn", "River", "Showdown"];

    /// <summary>
    /// The position of the street in <see cref="_stepTitles"/>. Street is not sequential (fact 10), so
    /// the order is spelled out here. A finished hand points past the last step, which marks every
    /// step done — including when the hand ended on a fold and never reached a showdown.
    /// </summary>
    private int CurrentIndex => Street switch
    {
        Street.PreFlop => 0,
        Street.Flop => 1,
        Street.Turn => 2,
        Street.River => 3,
        Street.Showdown => 4,
        Street.Finished => _stepTitles.Length,
        _ => 0
    };
}

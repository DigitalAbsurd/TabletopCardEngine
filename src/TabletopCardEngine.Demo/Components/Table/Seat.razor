@using TabletopCardEngine.Holdem.Dto
@using TabletopCardEngine.Holdem
@using DataCard = TabletopCardEngine.Card
@using TabletopCardEngine.Demo.Services

@* The badges share the stack's row rather than a row of their own: most seats carry none, and a
   reserved badge row was empty space in every one of them. *@
<div class="seat @GetSeatClasses()">
    <div class="seat-content">
        <div class="seat-name">@SeatData.Name</div>

        @if (SeatData.HasLeft)
        {
            <span class="badge-left" title="This player has stood up; the seat is free for the next hand">Left</span>
        }
        else if (CanStandUp)
        {
            @* Busted seats get it too: standing up is how a seat with no chips is freed. *@
            <button type="button"
                class="seat-stand-up"
                data-seat-no="@SeatData.SeatNo"
                aria-label="@($"Stand up {SeatData.Name}")"
                @onclick="@(() => OnStandUp.InvokeAsync(SeatData.SeatNo))">
                Stand up
            </button>
            @if (BuyInLabel is { } buyInLabel)
            {
                <button type="button"
                    class="seat-buy-in"
                    data-seat-no="@SeatData.SeatNo"
                    aria-label="@($"{buyInLabel} {SeatData.Name}")"
                    @onclick="OpenForm">
                    @buyInLabel
                </button>
            }
        }

        <div class="seat-stack">
            @if (IsDealer)
            {
                <span class="badge badge-dealer" title="Dealer Button">D</span>
            }
            @if (IsSmallBlind)
            {
                <span class="badge badge-small-blind" title="Small Blind">SB</span>
            }
            @if (IsBigBlind)
            {
                <span class="badge badge-big-blind" title="Big Blind">BB</span>
            }
            <span class="stack-amount">@AmountFormat.Format(SeatData.Stack)</span>
            @if (StackDelta != 0)
            {
                var sign = StackDelta > 0 ? "+" : "";
                var deltaClass = StackDelta > 0 ? "delta-positive" : "delta-negative";
                <span class="@deltaClass">(@sign@AmountFormat.Format(StackDelta))</span>
            }
        </div>

        @if (SeatData.PendingBuyIn > 0 || Options?.MaxRebuys is not null)
        {
            @* The engine adds the chips at the next hand, so the stack above stays as it is and this says what is coming. *@
            <div class="seat-buy-in-info">
                @if (SeatData.PendingBuyIn > 0)
                {
                    <span class="seat-pending">+@AmountFormat.Format(SeatData.PendingBuyIn) next hand</span>
                }
                @if (Options?.MaxRebuys is { } maxRebuys)
                {
                    <span class="seat-rebuys">Rebuys @SeatData.Rebuys/@maxRebuys</span>
                }
            </div>
        }

        @if (_form is { } form)
        {
            <SeatAmountForm
                Title="@form"
                SeatName="@SeatData.Name"
                InitialAmount="@SuggestedAmount"
                OnConfirm="ConfirmAsync"
                OnCancel="CloseForm" />
        }

        @if (SeatData.Hole?.Count > 0)
        {
            <div class="seat-hole-cards">
                @foreach (var card in SeatData.Hole)
                {
                    <PlayingCard Card="card" IsHighlighted="@(HighlightedCards?.Contains(card) == true)" />
                }
            </div>
        }

        @if (SeatData.LastAction is not null)
        {
            <div class="seat-last-action">
                <span class="action-type">@FormatActionType(SeatData.LastAction.ActionType)</span>
                @if (SeatData.LastAction.Size > 0)
                {
                    <span class="action-size">@AmountFormat.Format(SeatData.LastAction.Size)</span>
                }
            </div>
        }
    </div>
</div>

@code {
    /// <summary>The seat data to display.</summary>
    [Parameter]
    public required SeatData SeatData { get; set; }

    /// <summary>Whether this seat has the dealer button.</summary>
    [Parameter]
    public bool IsDealer { get; set; }

    /// <summary>Whether this seat posted the small blind.</summary>
    [Parameter]
    public bool IsSmallBlind { get; set; }

    /// <summary>Whether this seat posted the big blind.</summary>
    [Parameter]
    public bool IsBigBlind { get; set; }

    /// <summary>Whether this seat is currently to act.</summary>
    [Parameter]
    public bool IsActing { get; set; }

    /// <summary>The cards of this seat's combination to light up, or null when no result chip points here.</summary>
    [Parameter]
    public IReadOnlySet<DataCard>? HighlightedCards { get; set; }

    /// <summary>Whether the seat offers Stand up: between hands only, which the table decides.</summary>
    [Parameter]
    public bool CanStandUp { get; set; }

    /// <summary>Raised with the seat number when Stand up is pressed.</summary>
    [Parameter]
    public EventCallback<byte> OnStandUp { get; set; }

    /// <summary>The game's options, which say whether the seat may top up or rebuy and how far; null before a game exists.</summary>
    [Parameter]
    public GameOptionData? Options { get; set; }

    /// <summary>Raised with the seat number and the chips when a top-up or rebuy is confirmed.</summary>
    [Parameter]
    public EventCallback<(byte SeatNo, decimal Amount)> OnTopUp { get; set; }

    private const string TopUpLabel = "Top up";

    private const string RebuyLabel = "Rebuy";

    /// <summary>Below this a stack is empty, the demo's reading of a busted seat (the engine's own constant is private).</summary>
    private const decimal DecimalMinPrecision = 0.0001M;

    /// <summary>The form that is open, <c>Top up</c> or <c>Rebuy</c>, or null for none.</summary>
    private string? _form;

    private decimal StackDelta => SeatData.Stack - SeatData.StartHandStack;

    /// <summary>
    /// What the seat holds once the hand is over. <c>SeatData.Stack</c> is what is left after the
    /// wagers, before the pot is paid, so an all-in winner reads zero there: the engine's own figure,
    /// which decides top-up against rebuy, is the start stack plus the hand's net.
    /// </summary>
    private decimal FinishedStack => SeatData.HandResult is { } result ? SeatData.StartHandStack + result.Net : SeatData.Stack;

    /// <summary>
    /// The button the seat offers, or null for none. It follows the engine's own rule: a seat that
    /// would start the next hand with chips tops up, one that would not rebuys, so a busted seat that
    /// already has chips pending tops up again.
    /// </summary>
    private string? BuyInLabel
    {
        get
        {
            if (!CanStandUp || SeatData.HasLeft || Options is null)
            {
                return null;
            }

            if (FinishedStack + SeatData.PendingBuyIn >= DecimalMinPrecision)
            {
                return Options.AllowTopUp ? TopUpLabel : null;
            }

            var hasRebuysLeft = Options.MaxRebuys is not { } max || SeatData.Rebuys < max;
            return Options.AllowRebuy && hasRebuysLeft ? RebuyLabel : null;
        }
    }

    /// <summary>
    /// What the form starts with: the room left under the maximum buy-in when there is one, else the
    /// demo's default buy-in.
    /// </summary>
    private decimal SuggestedAmount
        => Options?.MaxBuyIn is { } maxBuyIn
            ? Math.Max(0m, maxBuyIn - FinishedStack - SeatData.PendingBuyIn)
            : DemoGameDefaults.BuyIn;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        // The table decides when it is between hands; once it is not, or the seat no longer offers the
        // button that opened it, the form goes with it.
        if (_form != BuyInLabel)
        {
            _form = null;
        }
    }

    private void OpenForm() => _form = BuyInLabel;

    private void CloseForm() => _form = null;

    private async Task ConfirmAsync(decimal amount)
    {
        _form = null;
        await OnTopUp.InvokeAsync((SeatData.SeatNo, amount));
    }

    private string GetSeatClasses()
    {
        var classes = new List<string>();

        if (IsActing)
            classes.Add("seat-acting");

        if (SeatData.IsFolded)
            classes.Add("seat-folded");

        if (SeatData.IsAllIn)
            classes.Add("seat-all-in");

        if (SeatData.HasLeft)
            classes.Add("seat-left");

        return string.Join(" ", classes);
    }

    private static string FormatActionType(HandActionType actionType)
    {
        return actionType switch
        {
            HandActionType.SmallBlind => "SB",
            HandActionType.BigBlind => "BB",
            HandActionType.Fold => "Fold",
            HandActionType.Check => "Check",
            HandActionType.Call => "Call",
            HandActionType.Raise => "Raise",
            HandActionType.Bet => "Bet",
            HandActionType.AllIn => "All-In",
            _ => actionType.ToString()
        };
    }
}

@using AntDesign
@using TabletopCardEngine.Demo.Phh
@using TabletopCardEngine.Demo.Services
@implements IAsyncDisposable

<Card Title="Hand History Export" Class="hand-history-export-card">
    <Space Direction="@DirectionVHType.Vertical" Style="width: 100%;">
        @if (_hasError)
        {
            <Alert
                Message="Error"
                Description="@_errorMessage"
                Type="@AlertType.Error"
                Closable="true"
                OnClose="@ClearError"
                ShowIcon="true" />
        }

        <p>Export the current hand or session as PHH format for backup or sharing.</p>

        <Space Direction="@DirectionVHType.Horizontal" Wrap="true" Style="width: 100%;">
            <SpaceItem>
                <Button Type="@ButtonType.Primary"
                        Disabled="@(!_canExport)"
                        OnClick="@ExportCurrentHand">
                    Export Current Hand (.phh)
                </Button>
            </SpaceItem>
            <SpaceItem>
                <Button Disabled="@(!_canExport)"
                        OnClick="@ExportSession">
                    Export Session (.phhs)
                </Button>
            </SpaceItem>
        </Space>

        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <Alert
                Message="Success"
                Description="@_successMessage"
                Type="@AlertType.Success"
                Closable="true"
                OnClose="@ClearSuccess"
                ShowIcon="true" />
        }
    </Space>
</Card>

@code {
    [Inject]
    private DemoGameSession? GameSession { get; set; }

    [Inject]
    private IJSRuntime? JS { get; set; }

    private bool _canExport => GameSession?.CurrentHand != null;
    private bool _hasError = false;
    private string _errorMessage = string.Empty;
    private string _successMessage = string.Empty;

    protected override void OnInitialized()
    {
        if (GameSession != null)
        {
            GameSession.StateChanged += OnGameStateChanged;
        }
    }

    private void OnGameStateChanged(object? sender, EventArgs e)
    {
        StateHasChanged();
    }

    private async Task ExportCurrentHand()
    {
        try
        {
            if (GameSession?.CurrentGame == null || GameSession.CurrentHand == null)
            {
                SetError("No hand is currently being played.");
                return;
            }

            var content = PhhWriter.WriteHand(GameSession.CurrentGame, GameSession.Journal);
            var fileName = $"hand-{GameSession.CurrentHand.No:D4}.phh";
            await DownloadFile(content, fileName, "text/plain");
            _successMessage = $"Hand #{GameSession.CurrentHand.No} exported successfully.";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            SetError($"Export failed: {ex.Message}");
        }
    }

    private async Task ExportSession()
    {
        try
        {
            if (GameSession?.CurrentGame == null)
            {
                SetError("No game is currently active.");
                return;
            }

            var content = PhhWriter.WriteSession(GameSession.CurrentGame, GameSession.Journal);
            var fileName = $"session-{GameSession.CurrentGameId:N}.phhs";
            await DownloadFile(content, fileName, "text/plain");
            _successMessage = "Session exported successfully.";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            SetError($"Export failed: {ex.Message}");
        }
    }

    private async Task DownloadFile(string content, string fileName, string mimeType)
    {
        if (JS == null)
        {
            throw new InvalidOperationException("JavaScript interop is not available.");
        }

        var bytes = System.Text.Encoding.UTF8.GetBytes(content);
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("downloadFile", base64, fileName, mimeType);
    }

    private void SetError(string message)
    {
        _errorMessage = message;
        _hasError = true;
        _successMessage = string.Empty;
    }

    private void ClearError()
    {
        _hasError = false;
        _errorMessage = string.Empty;
    }

    private void ClearSuccess()
    {
        _successMessage = string.Empty;
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (GameSession != null)
        {
            GameSession.StateChanged -= OnGameStateChanged;
        }

        await Task.CompletedTask;
    }
}

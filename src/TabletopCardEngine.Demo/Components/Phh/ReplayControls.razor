@using AntDesign
@using TabletopCardEngine.Demo.Services
@using TabletopCardEngine.Demo.Phh
@implements IAsyncDisposable
@inject PhhReplayController ReplayController
@inject DemoGameSession Session

<Card Title="Replay Controls" Class="replay-controls-card">
    <Space Direction="@DirectionVHType.Vertical" Style="width: 100%;">
        @if (ReplayController.CurrentHand == null)
        {
            <div style="text-align: center; padding: 20px; color: #999;">
                <p>Select a hand from the import panel to begin replay</p>
            </div>
        }
        else
        {
            <!-- Progress Indicator -->
            <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <span><strong>Progress:</strong> @ReplayController.ActionsReplayed / @ReplayController.TotalPlayerActions actions</span>
                    <span style="color: #999;">@(ReplayController.IsComplete ? "Complete" : "In progress")</span>
                </div>
                <Progress Percent="@(ReplayController.TotalPlayerActions > 0 ? (int)((ReplayController.ActionsReplayed * 100) / ReplayController.TotalPlayerActions) : 0)" />
            </div>

            <!-- Error Alert -->
            @if (!string.IsNullOrEmpty(ReplayController.ReplayError))
            {
                <Alert
                    Message="Replay Error"
                    Description="@ReplayController.ReplayError"
                    Type="@AlertType.Error"
                    Closable="false"
                    ShowIcon="true" />
            }

            <!-- Final Stacks Verification -->
            @if (ReplayController.IsComplete && !string.IsNullOrEmpty(ReplayController.FinalStacksMessage))
            {
                var stacksAlertType = ReplayController.FinalStacksMatch == true ? AlertType.Success
                                    : ReplayController.FinalStacksMatch == false ? AlertType.Warning
                                    : AlertType.Info;

                <Alert
                    Message="@(ReplayController.FinalStacksMatch == true ? "✓ Final Stacks Match" : "Final Stacks Verification")"
                    Description="@ReplayController.FinalStacksMessage"
                    Type="@stacksAlertType"
                    Closable="false"
                    ShowIcon="true" />
            }

            <!-- Control Buttons -->
            <div class="replay-controls-buttons">
                <Space>
                    <!-- Next Action Button -->
                    <Button
                        Type="@ButtonType.Primary"
                        OnClick="@OnNextActionAsync"
                        Loading="_isReplaying"
                        Disabled="@(ReplayController.IsComplete || _isAutoPlaying)"
                        Icon="forward">
                        Next Action
                    </Button>

                    <!-- Auto-play Button -->
                    <Button
                        Type="@(_isAutoPlaying ? ButtonType.Primary : ButtonType.Default)"
                        OnClick="@OnToggleAutoPlayAsync"
                        Loading="_isReplaying"
                        Disabled="@ReplayController.IsComplete"
                        Icon="@(_isAutoPlaying ? "pause" : "play")">
                        @(_isAutoPlaying ? "Pause" : "Auto-play")
                    </Button>

                    <!-- Reset Button -->
                    <Button
                        Type="@ButtonType.Default"
                        OnClick="@OnResetAsync"
                        Disabled="@(ReplayController.CurrentHand == null || _isReplaying || _isAutoPlaying)"
                        Icon="reload">
                        Reset
                    </Button>
                </Space>
            </div>

            <!-- Speed Control (only shown when auto-play is active or just paused) -->
            <div style="display: @(_isAutoPlaying ? "flex" : "none"); align-items: center; gap: 12px;">
                <span style="min-width: 60px;">Speed:</span>
                <Slider
                    Min="1"
                    Max="10"
                    Step="1"
                    @bind-Value="_autoPlaySpeed"
                    Style="flex: 1; min-width: 150px;"
                    Disabled="@_isReplaying" />
                <span style="min-width: 80px; text-align: right;">@(_autoPlaySpeedLabel)</span>
            </div>

            <!-- Hand Info -->
            <div style="padding: 12px; background: var(--demo-muted-surface); border-radius: 4px; font-size: 12px; color: var(--demo-muted-text);">
                <p style="margin: 0;">Hand: @ReplayController.CurrentHand.Source (#@ReplayController.CurrentHand.Index)</p>
                <p style="margin: 4px 0 0 0;">Players: @ReplayController.CurrentHand.PlayerCount | Blinds: @ReplayController.CurrentHand.SmallBlind/@ReplayController.CurrentHand.BigBlind | Actions: @ReplayController.CurrentHand.Actions.Length</p>
            </div>
        }
    </Space>
</Card>

@code {
    private bool _isReplaying = false;
    private bool _isAutoPlaying = false;
    private int _autoPlaySpeed = 5;
    private System.Threading.CancellationTokenSource? _autoPlayCts;

    [Parameter]
    public HandHistoryImport.HandHistoryItem? SelectedHand { get; set; }

    private string _autoPlaySpeedLabel => _autoPlaySpeed switch
    {
        1 => "Slow",
        2 => "1 sec/action",
        3 => "0.7 sec/action",
        4 => "0.5 sec/action",
        5 => "Normal",
        6 => "0.3 sec/action",
        7 => "0.2 sec/action",
        8 => "Fast",
        9 => "Very Fast",
        10 => "Instant",
        _ => "Normal"
    };

    private int GetAutoPlayDelayMs()
    {
        return _autoPlaySpeed switch
        {
            1 => 2000,
            2 => 1000,
            3 => 700,
            4 => 500,
            5 => 400,
            6 => 300,
            7 => 200,
            8 => 100,
            9 => 50,
            10 => 0,
            _ => 400
        };
    }

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to session state changes to update progress display
        Session.StateChanged += OnSessionStateChanged;
        await base.OnInitializedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // When a new hand is selected, load it
        if (SelectedHand?.Hand != null && ReplayController.CurrentHand != SelectedHand.Hand)
        {
            await LoadHandAsync();
        }
    }

    private void OnSessionStateChanged(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task LoadHandAsync()
    {
        if (SelectedHand?.Hand == null)
        {
            return;
        }

        _isReplaying = true;
        _isAutoPlaying = false;
        _autoPlayCts?.Cancel();
        _autoPlayCts = null;

        try
        {
            await ReplayController.LoadHandAsync(SelectedHand.Hand);
        }
        finally
        {
            _isReplaying = false;
        }
    }

    private async Task OnNextActionAsync()
    {
        _isReplaying = true;
        try
        {
            await ReplayController.ReplayNextActionAsync();
        }
        finally
        {
            _isReplaying = false;
        }
    }

    private Task OnToggleAutoPlayAsync()
    {
        if (_isAutoPlaying)
        {
            // Stop auto-play
            _isAutoPlaying = false;
            _autoPlayCts?.Cancel();
            _autoPlayCts = null;
        }
        else
        {
            // Start auto-play
            _isAutoPlaying = true;
            _autoPlayCts = new System.Threading.CancellationTokenSource();
            _ = RunAutoPlayAsync(_autoPlayCts.Token);
        }

        return Task.CompletedTask;
    }

    private async Task RunAutoPlayAsync(System.Threading.CancellationToken cancellationToken)
    {
        try
        {
            while (_isAutoPlaying && !ReplayController.IsComplete && !cancellationToken.IsCancellationRequested)
            {
                var delayMs = GetAutoPlayDelayMs();
                if (delayMs > 0)
                {
                    await Task.Delay(delayMs, cancellationToken);
                }

                if (cancellationToken.IsCancellationRequested)
                {
                    break;
                }

                _isReplaying = true;
                try
                {
                    await ReplayController.ReplayNextActionAsync();
                    await InvokeAsync(StateHasChanged);
                }
                finally
                {
                    _isReplaying = false;
                }
            }

            // Auto-play completed
            _isAutoPlaying = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (System.OperationCanceledException)
        {
            // Auto-play was cancelled
        }
        catch (Exception ex)
        {
            // Surface unexpected errors through the replay error display
            ReplayController.ReplayError = $"Auto-play failed: {ex.Message}";
            _isAutoPlaying = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnResetAsync()
    {
        _isAutoPlaying = false;
        _autoPlayCts?.Cancel();
        _autoPlayCts = null;
        ReplayController.Reset();

        // Reload the hand to reset the engine state
        if (SelectedHand?.Hand != null)
        {
            await LoadHandAsync();
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        Session.StateChanged -= OnSessionStateChanged;
        _autoPlayCts?.Dispose();

        // Uninstall the PHH shuffler so subsequent games can deal at random
        ReplayController.Unload();

        await Task.CompletedTask;
    }
}

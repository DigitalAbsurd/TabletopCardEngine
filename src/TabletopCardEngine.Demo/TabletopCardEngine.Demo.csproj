<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- WebAssembly native SQLite build -->
    <WasmBuildNative>true</WasmBuildNative>
    <!--
      SQLitePCLRaw's e_sqlite3 exposes varargs native functions (sqlite3_config,
      sqlite3_db_config). The wasm native linker flags every P/Invoke against them,
      but this app never calls those overloads, so the warning is noise.
    -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);WASM0001</MSBuildWarningsAsMessages>
    <!--
      AntDesign 1.6.2 is not trim-safe: with the default full trim mode the published app throws
      TypeLoadException ("Invalid generic instantiation") in AntDesign.Tooltip and the first render dies.
      Partial mode trims only the assemblies that declare themselves trimmable, and leaves AntDesign whole.
    -->
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AntDesign" Version="1.6.2" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Tomlyn" Version="0.19.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Publishing copies the dependencies into the site, so their notices ship with it. -->
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="wwwroot\THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../TabletopCardEngine/TabletopCardEngine.csproj" />
    <ProjectReference Include="../TabletopCardEngine.Sqlite/TabletopCardEngine.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      EF finds the migrations by reflection over [Migration]-attributed types that nothing references
      statically, so the trimmer would drop them and MigrateAsync would throw MigrationsNotFound at start-up.
    -->
    <TrimmerRootAssembly Include="TabletopCardEngine.Sqlite" />
  </ItemGroup>

  <!--
    Reconvert the webcil after a restore that changed the packages. ConvertDllsToWebCil converts a DLL only
    when it is newer than the existing webcil, and NuGet extracts a package's files with the timestamps they
    were packed with, so a bumped package's DLL can be older than the webcil built from the previous version
    and the stale one keeps being served (AntDesign 0.17.0 next to code compiled against 1.6.2: TypeLoadException
    "Invalid generic instantiation"). NuGet rewrites project.assets.json only when the resolved packages change,
    so a normal incremental build pays nothing. webcil/ also holds webcil/publish, so this covers dotnet publish.
    Remove it once the SDK compares inputs rather than timestamps: https://github.com/dotnet/runtime/issues/137825
    (diagnosis in #816). The target must run before _ResolveWasmOutputs, which does the conversion.
  -->
  <Target Name="_TceInvalidateWebcilOnRestore" BeforeTargets="_ResolveWasmOutputs" Inputs="$(ProjectAssetsFile)" Outputs="$(IntermediateOutputPath)webcil.assets.stamp">
    <RemoveDir Directories="$(IntermediateOutputPath)webcil" />
    <Touch Files="$(IntermediateOutputPath)webcil.assets.stamp" AlwaysCreate="true" />
  </Target>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <NeutralLanguage>en-US</NeutralLanguage>
    <!-- Public API documentation is mandatory: CS1591 -> error via TreatWarningsAsErrors. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Public API baseline">
    <!--
      dotnet pack compares the public surface against the committed baseline package and fails
      on a removed or changed member (CP0001, CP0002, ...). Until 1.0.0 is on nuget.org there is
      no published version to resolve, so the baseline is a package in the tree. Changing the
      surface means re-packing it in the same pull request: see docs/public-api.md.
    -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselinePath>$(MSBuildThisFileDirectory)../../eng/api-baseline/OpenHoldemEngine.1.0.0-baseline.nupkg</PackageValidationBaselinePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.1" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Abstractions" Version="9.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(AssemblyName).Tests" />
    <InternalsVisibleTo Include="$(AssemblyName).Demo" />
    <InternalsVisibleTo Include="$(AssemblyName).Demo.Tests" />
    <InternalsVisibleTo Include="$(AssemblyName).Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\PackResource.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>PackResource.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\PackResource.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>PackResource.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>

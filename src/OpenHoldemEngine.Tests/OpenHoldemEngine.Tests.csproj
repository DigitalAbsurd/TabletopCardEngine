<Project Sdk="MSTest.Sdk/3.6.1">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!--
      The documentation file is generated only to enable IDE0005 (unnecessary using) at build time;
      docs on the test classes themselves aren't needed, so CS1591/CS1573 are suppressed.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <!--
      Displays error on console in addition to the log file. Note that this feature comes with a performance impact.
      For more information, visit https://learn.microsoft.com/dotnet/core/testing/unit-testing-platform-integration-dotnet-test#show-failure-per-test
      -->
    <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
    <TestingExtensionsProfile>None</TestingExtensionsProfile>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\phh\pluribus.phhs.gz" />
    <None Remove="Resources\phh\handhq-headsup.phhs.gz" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\phh\pluribus.phhs.gz" />
    <EmbeddedResource Include="Resources\phh\handhq-headsup.phhs.gz" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions.Json" Version="6.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.1.0" />
    <PackageReference Include="OpenTelemetry" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" Version="1.19.1" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.15.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageReference Include="Tomlyn" Version="0.19.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenHoldemEngine\OpenHoldemEngine.csproj" />
    <ProjectReference Include="..\OpenHoldemEngine.OpenTelemetry\OpenHoldemEngine.OpenTelemetry.csproj" />
    <ProjectReference Include="..\OpenHoldemEngine.Sqlite\OpenHoldemEngine.Sqlite.csproj" />
    <ProjectReference Include="..\OpenHoldemEngine.InMemory\OpenHoldemEngine.InMemory.csproj" />
    <ProjectReference Include="..\OpenHoldemEngine.PostgreSql\OpenHoldemEngine.PostgreSql.csproj" />
    <ProjectReference Include="..\OpenHoldemEngine.SqlServer\OpenHoldemEngine.SqlServer.csproj" />
  </ItemGroup>

</Project>

@page "/"
@using AntDesign
@using Microsoft.AspNetCore.Components.Web
@using OpenHoldemEngine.Demo.Services
@using OpenHoldemEngine.Demo.Components.Database
@using OpenHoldemEngine.Demo.Components.Phh
@using OpenHoldemEngine.Demo.Components
@using OpenHoldemEngine.Demo.Components.EngineCalls
@using OpenHoldemEngine.Demo.Components.Table
@implements IAsyncDisposable
@inject BrowserStorage Storage
@inject DemoGameSession Session
@inject PhhReplayController ReplayController
@inject NewGameState NewGameState

<PageTitle>OpenHoldemEngine Demo</PageTitle>

<ErrorBoundary @ref="_walkthroughErrorBoundary">
    <ChildContent>
        <FirstVisitWalkthrough />
    </ChildContent>
    <ErrorContent Context="ex">
        <div style="background: #fff2f0; border: 1px solid #ffccc7; border-radius: 4px; padding: 16px; color: #cf1322;">
            <ErrorCardContent ExceptionMessage="@ex.Message" OnRetryClick="@(async () => await OnWalkthroughErrorRetryAsync())" />
        </div>
    </ErrorContent>
</ErrorBoundary>

@if (_showStorageAlert)
{
    @* One line on purpose: it sits above the table on the first visit, and every pixel it takes is
       one the action bar loses at the bottom of a 768px-high screen. *@
    <Alert
        Message="The game lives in this tab's memory only: a reload discards it. Export hands to .phh to keep them."
        Type="@AlertType.Info"
        Closable="true"
        OnClose="@OnAlertClose"
        Class="storage-alert"
        ShowIcon="true" />
}

@if (!string.IsNullOrEmpty(_bootErrorMessage))
{
    <Alert
        Message="The demo game could not be started"
        Description="@_bootErrorMessage"
        Type="@AlertType.Error"
        Closable="false"
        Class="storage-alert"
        ShowIcon="true" />
}

<div class="home-container">
    <ErrorBoundary @ref="_tableErrorBoundary">
        <ChildContent>
            @* The table is the whole region: the street, the session's settings, the hand's outcome
               and the action bar are all drawn on it, so nothing about the hand is shown twice. *@
            <div class="main-region">
                <PokerTable
                    GameData="@Session.CurrentGame"
                    OnNextHand="@OnNextHandAsync"
                    OnNewGame="@OpenNewGameModalAsync" />
            </div>
        </ChildContent>
        <ErrorContent Context="ex">
            <div class="main-region" style="background: #fff2f0; border: 1px solid #ffccc7; border-radius: 4px; padding: 16px; color: #cf1322;">
                <ErrorCardContent ExceptionMessage="@ex.Message" OnRetryClick="@(async () => await OnTableErrorRetryAsync())" />
            </div>
        </ErrorContent>
    </ErrorBoundary>

    @* Visual Studio's tool-window layout: the table is the workspace, the companions share one
       column behind a rail of named tabs, and exactly one of them is shown. Every pane stays
       mounted and the inactive ones are only hidden, so the inspector keeps its selected table
       and the call log its entries while another tab is in front. *@
    <div class="companion-panels">
        <div class="companion-content">
            <div id="companion-pane-@DatabaseCompanion" class="@PaneClass(DatabaseCompanion)" role="tabpanel" data-companion="@DatabaseCompanion">
                <ErrorBoundary @ref="_databaseErrorBoundary">
                    <ChildContent>
                        <DatabaseInspector />
                    </ChildContent>
                    <ErrorContent Context="ex">
                        <div style="background: #fff2f0; border: 1px solid #ffccc7; border-radius: 4px; padding: 16px; color: #cf1322;">
                            <ErrorCardContent ExceptionMessage="@ex.Message" OnRetryClick="@(async () => await OnDatabaseErrorRetryAsync())" />
                        </div>
                    </ErrorContent>
                </ErrorBoundary>
            </div>

            <div id="companion-pane-@EngineCallsCompanion" class="@PaneClass(EngineCallsCompanion)" role="tabpanel" data-companion="@EngineCallsCompanion">
                <ErrorBoundary @ref="_engineCallsErrorBoundary">
                    <ChildContent>
                        <EngineCalls @ref="_engineCallsComponent" />
                    </ChildContent>
                    <ErrorContent Context="ex">
                        <div style="background: #fff2f0; border: 1px solid #ffccc7; border-radius: 4px; padding: 16px; color: #cf1322;">
                            <ErrorCardContent ExceptionMessage="@ex.Message" OnRetryClick="@(async () => await OnEngineCallsErrorRetryAsync())" />
                        </div>
                    </ErrorContent>
                </ErrorBoundary>
            </div>

            <div id="companion-pane-@HandHistoryCompanion" class="@PaneClass(HandHistoryCompanion)" role="tabpanel" data-companion="@HandHistoryCompanion">
                <HandHistoryImport OnHandSelected="@OnHandSelected" />

                @if (_selectedHistoryHand is not null)
                {
                    <ReplayControls SelectedHand="@_selectedHistoryHand" />
                }

                <HandHistoryExport />
            </div>
        </div>

        <div class="companion-tab-rail" role="tablist" aria-orientation="vertical">
            @foreach (var tab in _companionTabs)
            {
                var isActive = tab.Key == _activeCompanion;
                <button type="button"
                    class="@(isActive ? "companion-tab companion-tab-active" : "companion-tab")"
                    role="tab"
                    data-companion="@tab.Key"
                    aria-selected="@(isActive ? "true" : "false")"
                    aria-controls="companion-pane-@tab.Key"
                    aria-label="@tab.Title"
                    title="@tab.Title"
                    @onclick="@(() => SelectCompanion(tab.Key))">
                    <Icon Type="@tab.Icon" Theme="outline" />
                    <span class="companion-tab-label">@tab.Title</span>
                </button>
            }
        </div>
    </div>
</div>

@* The settings form lives here and nowhere else: reconfiguring the session is a modal over the
   running game, not a screen the demo navigates to. MaskClosable is off so the only ways out are
   Apply, Cancel and the close button. *@
<Modal Visible="_newGameVisible"
    Title="New Game"
    OkText="@ApplyLabel"
    CancelText="@CancelLabel"
    OnOk="OnNewGameOkAsync"
    OnCancel="OnNewGameCancelAsync"
    ConfirmLoading="_isApplying"
    Width="720"
    MaskClosable="false"
    Closable="true">
    <GameSetup @ref="_gameSetup" />
</Modal>

@code {
    private bool _showStorageAlert = false;
    private HandHistoryImport.HandHistoryItem? _selectedHistoryHand;
    private const string StorageAlertKey = "ohe-demo-storage-alert-dismissed";
    private ErrorBoundary? _tableErrorBoundary;
    private ErrorBoundary? _databaseErrorBoundary;
    private ErrorBoundary? _engineCallsErrorBoundary;
    private ErrorBoundary? _walkthroughErrorBoundary;
    private EngineCalls? _engineCallsComponent;
    private GameSetup? _gameSetup;
    private bool _newGameVisible;
    private bool _isApplying;
    private string? _bootErrorMessage;

    private const string ApplyLabel = "Apply";
    private const string CancelLabel = "Cancel";

    private const string DatabaseCompanion = "database";
    private const string EngineCallsCompanion = "engine-calls";
    private const string HandHistoryCompanion = "hand-history";

    private static readonly CompanionTab[] _companionTabs =
    [
        new(DatabaseCompanion, "Database Inspector", "database"),
        new(EngineCallsCompanion, "Engine Calls", "code"),
        new(HandHistoryCompanion, "Hand History", "history"),
    ];

    private string _activeCompanion = DatabaseCompanion;

    /// <summary>
    /// Set when the Engine Calls tab comes to the front. The call log can only be scrolled once
    /// its pane is displayed again, which is after the render that un-hides it.
    /// </summary>
    private bool _scrollEngineCallsAfterRender;

    private sealed record CompanionTab(string Key, string Title, string Icon);

    private string PaneClass(string key)
    {
        return key == _activeCompanion ? "companion-pane companion-pane-active" : "companion-pane";
    }

    private void SelectCompanion(string key)
    {
        if (key == _activeCompanion)
        {
            return;
        }

        _activeCompanion = key;
        _scrollEngineCallsAfterRender = key == EngineCallsCompanion;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollEngineCallsAfterRender)
        {
            _scrollEngineCallsAfterRender = false;
            if (_engineCallsComponent != null)
            {
                await _engineCallsComponent.ScrollToLatestEntryAsync();
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var isDismissed = await Storage.GetFlagAsync(StorageAlertKey);
            _showStorageAlert = !isDismissed;
        }
        catch
        {
            // If storage service fails, show the alert
            _showStorageAlert = true;
        }

        Session.StateChanged += OnSessionStateChanged;
        Session.EngineError += OnBootEngineError;
        NewGameState.ShowRequested += OpenNewGameModalAsync;

        await StartDefaultGameIfNeededAsync();

        Session.EngineError -= OnBootEngineError;
    }

    /// <summary>
    /// Deals the demo's default game on arrival. DemoGameSession is scoped and outlives a re-render
    /// of this page, so an existing game is left alone rather than replaced.
    /// </summary>
    private async Task StartDefaultGameIfNeededAsync()
    {
        if (Session.CurrentGame is not null)
        {
            return;
        }

        if (!await Session.CreateGameAsync(DemoGameDefaults.CreateOptions()))
        {
            return;
        }

        await Session.StartFirstHandAsync(DemoGameDefaults.CreateJoinSeats());
    }

    private void OnBootEngineError(object? sender, EngineErrorEventArgs e)
    {
        _bootErrorMessage = e.Message;
    }

    private void OnSessionStateChanged(object? sender, EventArgs e)
    {
        StateHasChanged();
    }

    private async Task OnAlertClose()
    {
        _showStorageAlert = false;
        try
        {
            await Storage.SetFlagAsync(StorageAlertKey, true);
        }
        catch
        {
            // Ignore storage errors
        }
    }

    private async Task OnNextHandAsync()
    {
        await Session.StartNextHandAsync();
    }

    /// <summary>Opens the New Game modal on a form that starts from the defaults every time.</summary>
    private Task OpenNewGameModalAsync()
    {
        _gameSetup?.ResetToDefaults();
        _newGameVisible = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task OnNewGameOkAsync(MouseEventArgs args)
    {
        if (_gameSetup is null)
        {
            return;
        }

        _isApplying = true;
        try
        {
            // A failed apply keeps the modal open: the form is where the reason is shown.
            if (await _gameSetup.ApplyAsync())
            {
                _bootErrorMessage = null;
                _selectedHistoryHand = null;
                _newGameVisible = false;
            }
        }
        finally
        {
            _isApplying = false;
        }
    }

    private Task OnNewGameCancelAsync(MouseEventArgs args)
    {
        _newGameVisible = false;
        return Task.CompletedTask;
    }

    private Task OnHandSelected(HandHistoryImport.HandHistoryItem hand)
    {
        _selectedHistoryHand = hand;
        return Task.CompletedTask;
    }

    private async Task OnTableErrorRetryAsync()
    {
        _tableErrorBoundary?.Recover();
        await Task.CompletedTask;
    }

    private async Task OnDatabaseErrorRetryAsync()
    {
        _databaseErrorBoundary?.Recover();
        await Task.CompletedTask;
    }

    private async Task OnEngineCallsErrorRetryAsync()
    {
        _engineCallsErrorBoundary?.Recover();
        await Task.CompletedTask;
    }

    private async Task OnWalkthroughErrorRetryAsync()
    {
        _walkthroughErrorBoundary?.Recover();
        await Task.CompletedTask;
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        Session.StateChanged -= OnSessionStateChanged;
        NewGameState.ShowRequested -= OpenNewGameModalAsync;
        await Task.CompletedTask;
    }
}

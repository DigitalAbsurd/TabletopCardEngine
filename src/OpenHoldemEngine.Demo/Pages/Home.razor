@page "/"
@using AntDesign
@using OpenHoldemEngine.Demo.Services
@using OpenHoldemEngine.Demo.Components.Database
@using OpenHoldemEngine.Demo.Components.Phh
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject DemoGameSession Session

<PageTitle>OpenHoldemEngine Demo</PageTitle>

@if (_showStorageAlert)
{
    <Alert
        Message="Database is in-memory only"
        Description="This demo stores your game in your browser's memory. If you reload the page, your game will be lost. Use the .phh export feature to save hands for later."
        Type="AlertType.Info"
        Closable="true"
        OnClose="@OnAlertClose"
        Class="storage-alert"
        ShowIcon="true" />
}

<div class="home-container">
    <div class="main-region">
        @if (Session.CurrentGame is not null)
        {
            @if (Session.CurrentHand is not null)
            {
                <StreetIndicator Street="@Session.CurrentHand.Street" />
            }

            <PokerTable HandData="@Session.CurrentHand" />

            @if (Session.CurrentHand is not null)
            {
                <ActionPanel HandData="@Session.CurrentHand" />
            }

            <HandHistory CurrentGameData="@Session.CurrentGame" />

            <HandResult
                GameData="@Session.CurrentGame"
                OnNextHand="@OnNextHandAsync"
                OnNewGame="@OnNewGameAsync" />
        }
        else
        {
            <GameSetup />
        }
    </div>

    <div class="companion-panels">
        @if (Session.CurrentGame is null)
        {
            <!-- Show hand history import when no game is active -->
            <div class="companion-panel">
                <HandHistoryImport OnHandSelected="@OnHandSelected" />
            </div>

            @if (_selectedHistoryHand is not null)
            {
                <div class="companion-panel">
                    <ReplayControls SelectedHand="@_selectedHistoryHand" />
                </div>
            }
        }
        else
        {
            <!-- Show database inspector and engine calls when game is active -->
            <div class="companion-panel database-panel">
                <DatabaseInspector />
            </div>

            <div class="companion-panel engine-calls-panel">
                <EngineCalls />
            </div>
        }
    </div>
</div>

@code {
    private bool _showStorageAlert = false;
    private HandHistoryImport.HandHistoryItem? _selectedHistoryHand;
    private const string StorageAlertKey = "ohe-demo-storage-alert-dismissed";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var isDismissed = await JS.InvokeAsync<bool>("localStorage.getItem", StorageAlertKey);
            _showStorageAlert = !isDismissed;
        }
        catch
        {
            // If localStorage is not available, show the alert
            _showStorageAlert = true;
        }

        Session.StateChanged += OnSessionStateChanged;
    }

    private void OnSessionStateChanged(object? sender, EventArgs e)
    {
        StateHasChanged();
    }

    private async Task OnAlertClose()
    {
        _showStorageAlert = false;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", StorageAlertKey, "true");
        }
        catch
        {
            // Ignore localStorage errors
        }
    }

    private async Task OnNextHandAsync()
    {
        await Session.StartNextHandAsync();
    }

    private async Task OnNewGameAsync()
    {
        Session.Reset();
        await Task.CompletedTask;
        StateHasChanged();
    }

    private Task OnHandSelected(HandHistoryImport.HandHistoryItem hand)
    {
        _selectedHistoryHand = hand;
        return Task.CompletedTask;
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        Session.StateChanged -= OnSessionStateChanged;
        await Task.CompletedTask;
    }
}

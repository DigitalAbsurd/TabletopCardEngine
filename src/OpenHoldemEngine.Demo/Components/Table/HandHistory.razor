@using OpenHoldemEngine.Dto
@using OpenHoldemEngine.Data

<div class="hand-history">
    <div class="history-header">
        <h3>Game History</h3>
    </div>
    <div class="history-list">
        @if (CurrentGameData?.HandData != null)
        {
            <div class="history-placeholder">
                <span class="stat-label">Current Hand:</span>
                <span class="stat-value">@CurrentGameData.HandData.No</span>
            </div>

            <div class="history-stats">
                @if (CurrentGameData.HandData.Seats.Length > 0)
                {
                    var activePlayers = CurrentGameData.HandData.Seats.Count(s => s.IsActive);
                    <div class="stat">
                        <span class="stat-label">Active:</span>
                        <span class="stat-value">@activePlayers/@CurrentGameData.HandData.Seats.Length</span>
                    </div>
                }

                <div class="stat">
                    <span class="stat-label">Total Pot:</span>
                    <span class="stat-value">@(CurrentGameData.HandData.Pot + CurrentGameData.HandData.StreetPot).ToString("F2")</span>
                </div>
            </div>
        }
        else
        {
            <div class="empty-state">
                <p>No hands played yet</p>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public GameData? CurrentGameData { get; set; }
}

<style>
    .hand-history {
        background: #2a2a2a;
        border: 1px solid #444;
        border-radius: 8px;
        padding: 1rem;
        color: #e0e0e0;
    }

    .history-header {
        margin-bottom: 1rem;
        border-bottom: 1px solid #555;
        padding-bottom: 0.5rem;
    }

    .history-header h3 {
        margin: 0;
        color: #6ac88a;
        font-size: 1.1rem;
    }

    .history-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .history-placeholder,
    .stat {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.5rem;
        background: #1a1a1a;
        border-radius: 4px;
        border-left: 3px solid #4a9a6a;
    }

    .history-stats {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .stat-label {
        font-size: 0.9rem;
        color: #999;
    }

    .stat-value {
        font-weight: bold;
        color: #fff;
        font-size: 1rem;
    }

    .empty-state {
        text-align: center;
        padding: 1.5rem;
        color: #777;
    }

    .empty-state p {
        margin: 0;
    }
</style>

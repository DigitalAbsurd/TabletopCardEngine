@using AntDesign
@using OpenHoldemEngine.Data
@using OpenHoldemEngine.Dto

@* The action bar along the bottom of the table: the buttons on the left, the raise sizing in the
   middle, and on the right the name of the player whose turn it is. Button colours are in app.css,
   because an AntDesign Button's element never carries this component's scope attribute (fact 22). *@
<div class="action-panel action-bar">
    <div class="action-bar-controls">
        @if (IsHandFinished)
        {
            <div class="action-bar-buttons">
                <Button
                    Type="primary"
                    Size="large"
                    OnClick="@OnNextHandAsync"
                    Loading="_isSubmitting"
                    Class="action-bar-btn next-hand-btn">
                    Next Hand
                </Button>
                <Button
                    Type="primary"
                    Danger="true"
                    Size="large"
                    OnClick="@OnNewGameAsync"
                    Loading="_isSubmitting"
                    Class="action-bar-btn bar-new-game-btn">
                    New Game
                </Button>
            </div>
        }
        else if (HasActions)
        {
            <div class="action-bar-buttons">
                @if (HasAction(PlayerActionType.Fold))
                {
                    <Button
                        Type="primary"
                        Danger="true"
                        Size="large"
                        OnClick="@OnFoldAsync"
                        Loading="_isSubmitting"
                        Class="action-btn fold-btn">
                        Fold
                    </Button>
                }

                @if (HasAction(PlayerActionType.Check))
                {
                    <Button
                        Type="primary"
                        Size="large"
                        OnClick="@OnCheckAsync"
                        Loading="_isSubmitting"
                        Class="action-btn check-btn">
                        Check
                    </Button>
                }

                @if (HasAction(PlayerActionType.Call))
                {
                    <Button
                        Type="primary"
                        Size="large"
                        OnClick="@OnCallAsync"
                        Loading="_isSubmitting"
                        Class="action-btn call-btn">
                        @GetCallLabel()
                    </Button>
                }

                @if (HasAction(PlayerActionType.Raise))
                {
                    @if (IsAllInOnly())
                    {
                        <Button
                            Type="primary"
                            Size="large"
                            OnClick="@(async () => await OnRaiseAsync(GetAllInAmount()))"
                            Loading="_isSubmitting"
                            Class="action-btn allin-btn">
                            All-in @GetAllInAmount().ToString("F2")
                        </Button>
                    }
                    else
                    {
                        <Button
                            Type="primary"
                            Size="large"
                            OnClick="@(async () => await OnRaiseAsync(_raiseAmount))"
                            Loading="_isSubmitting"
                            Class="action-btn raise-btn">
                            Raise to @_raiseAmount.ToString("F2")
                        </Button>
                    }
                }
            </div>

            @if (HasAction(PlayerActionType.Raise) && !IsAllInOnly())
            {
                <div class="raise-controls">
                    <div class="raise-shortcuts">
                        <Button Size="small" OnClick="@(() => SetRaiseAmount(GetHalfPotRaise()))" Class="shortcut-btn">1/2 Pot</Button>
                        <Button Size="small" OnClick="@(() => SetRaiseAmount(GetPotRaise()))" Class="shortcut-btn">Pot</Button>
                        <Button Size="small" OnClick="@(() => SetRaiseAmount(GetAllInRaise()))" Class="shortcut-btn">All-in</Button>
                    </div>

                    <div class="raise-slider-row">
                        <Button
                            Size="small"
                            Shape="circle"
                            OnClick="@(() => StepRaiseAmount(-1))"
                            Class="raise-step-btn raise-decrease-btn">
                            −
                        </Button>
                        <input
                            type="range"
                            min="@FormatInvariant(GetRaiseWindow().Min)"
                            max="@FormatInvariant(GetRaiseWindow().Max)"
                            step="0.01"
                            value="@FormatInvariant(_raiseAmount)"
                            @oninput="@OnRaiseSliderChanged"
                            aria-label="Raise amount"
                            class="slider-input" />
                        <Button
                            Size="small"
                            Shape="circle"
                            OnClick="@(() => StepRaiseAmount(1))"
                            Class="raise-step-btn raise-increase-btn">
                            +
                        </Button>
                        <input
                            type="number"
                            step="0.01"
                            value="@FormatInvariant(_raiseAmount)"
                            @onchange="@OnRaiseInputChanged"
                            aria-label="Raise to"
                            class="raise-input" />
                    </div>
                </div>
            }
        }
        else
        {
            <div class="no-actions">No actions available</div>
        }
    </div>

    <div class="action-bar-info" aria-live="polite">@InfoText</div>
</div>

@code {
    // Component logic is in ActionPanel.razor.cs
}

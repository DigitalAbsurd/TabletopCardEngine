@using AntDesign
@using OpenHoldemEngine.Dto
@using OpenHoldemEngine.Data

<div class="hand-result-container">
    @if (IsHandFinished)
    {
        <div class="hand-result-overlay">
            <div class="hand-result-content">
                <h2>Hand Complete</h2>

                <div class="results-section">
                    @if (GameData?.HandData?.Seats != null)
                    {
                        <div class="seats-results">
                            @foreach (var seat in GameData.HandData.Seats.OrderBy(s => s.SeatNo))
                            {
                                @if (seat.HandResult != null)
                                {
                                    var resultClass = seat.HandResult.Net > 0 ? "result-winner" : seat.HandResult.Net < 0 ? "result-loser" : "result-neutral";
                                    <div class="seat-result @resultClass">
                                        <div class="result-player">
                                            <span class="result-name">@seat.Name</span>
                                            <span class="result-rank">@FormatRankType(seat.HandResult.RankType)</span>
                                        </div>
                                        <div class="result-amount">
                                            <span class="@(seat.HandResult.Net > 0 ? "amount-win" : seat.HandResult.Net < 0 ? "amount-loss" : "amount-neutral")">
                                                @(seat.HandResult.Net > 0 ? "+" : "")@seat.HandResult.Net.ToString("F2")
                                            </span>
                                        </div>
                                        @if (seat.Hole?.Length > 0)
                                        {
                                            <div class="result-cards">
                                                @foreach (var card in seat.Hole)
                                                {
                                                    <span class="card-text">@card</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>

                        <div class="pot-result">
                            <span class="pot-label">Total Pot:</span>
                            <span class="pot-value">@CalculateTotalPot().ToString("F2")</span>
                        </div>
                    }
                </div>

                <div class="actions-section">
                    <Button Type="primary" Size="large" OnClick="OnNextHandAsync" Loading="_isSubmitting" Class="action-button">
                        Next Hand
                    </Button>
                    <Button Type="primary" Danger="true" Size="large" OnClick="OnNewGameAsync" Loading="_isSubmitting" Class="action-button">
                        New Game
                    </Button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public GameData? GameData { get; set; }

    [Parameter]
    public EventCallback OnNextHand { get; set; }

    [Parameter]
    public EventCallback OnNewGame { get; set; }

    private bool _isSubmitting = false;

    private bool IsHandFinished =>
        GameData?.HandData != null &&
        GameData.HandData.NextPlayerSeatNo == 0 &&
        GameData.HandData.Evaluations.Length == 0 &&
        GameData.HandData.Street == Street.Finished;

    private static string FormatRankType(HandRankType rankType)
    {
        return rankType switch
        {
            HandRankType.HighCard => "High Card",
            HandRankType.Pair => "Pair",
            HandRankType.TwoPair => "Two Pair",
            HandRankType.Trips => "Three of a Kind",
            HandRankType.Straight => "Straight",
            HandRankType.Flush => "Flush",
            HandRankType.FullHouse => "Full House",
            HandRankType.FourOfAKind => "Four of a Kind",
            HandRankType.StraightFlush => "Straight Flush",
            _ => "No Hand"
        };
    }

    private decimal CalculateTotalPot()
    {
        if (GameData?.HandData?.Seats == null)
        {
            return 0m;
        }

        // Pot already includes prior streets, but we need to add the winnings to get the total
        // that was in play. We can calculate it from the seat stacks and starting stacks.
        // Actually, for display, we can just show the sum of all the antes/blinds/bets/raises
        // by looking at each seat's starting stack minus current stack.
        var totalInvested = GameData.HandData.Seats.Sum(s => s.StartHandStack - s.Stack);
        return totalInvested;
    }

    private async Task OnNextHandAsync()
    {
        _isSubmitting = true;
        await OnNextHand.InvokeAsync();
        _isSubmitting = false;
    }

    private async Task OnNewGameAsync()
    {
        _isSubmitting = true;
        await OnNewGame.InvokeAsync();
        _isSubmitting = false;
    }
}

<style>
    .hand-result-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .hand-result-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .hand-result-content {
        background: #1a1a1a;
        border: 2px solid #4a9a6a;
        border-radius: 12px;
        padding: 2rem;
        max-width: 600px;
        max-height: 80vh;
        overflow-y: auto;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
        color: #e0e0e0;
    }

    .hand-result-content h2 {
        text-align: center;
        color: #6ac88a;
        margin-bottom: 1.5rem;
        font-size: 1.8rem;
    }

    .results-section {
        margin-bottom: 2rem;
    }

    .seats-results {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .seat-result {
        display: grid;
        grid-template-columns: 1fr auto auto;
        gap: 1rem;
        padding: 1rem;
        border-radius: 8px;
        border: 1px solid #444;
        align-items: center;
    }

    .seat-result.result-winner {
        background: rgba(74, 154, 106, 0.2);
        border-color: #6ac88a;
    }

    .seat-result.result-loser {
        background: rgba(200, 74, 74, 0.2);
        border-color: #c84a4a;
    }

    .seat-result.result-neutral {
        background: rgba(100, 100, 100, 0.2);
        border-color: #666;
    }

    .result-player {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .result-name {
        font-weight: bold;
        color: #fff;
    }

    .result-rank {
        font-size: 0.9rem;
        color: #bbb;
    }

    .result-amount {
        font-size: 1.2rem;
        font-weight: bold;
        text-align: right;
    }

    .amount-win {
        color: #6ac88a;
    }

    .amount-loss {
        color: #c84a4a;
    }

    .amount-neutral {
        color: #999;
    }

    .result-cards {
        display: flex;
        gap: 0.5rem;
        font-family: monospace;
        font-weight: bold;
        font-size: 1rem;
        color: #fff;
        text-align: right;
    }

    .card-text {
        background: #2a2a2a;
        border: 1px solid #444;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
    }

    .pot-result {
        display: flex;
        justify-content: center;
        gap: 1rem;
        padding: 1rem;
        background: rgba(74, 154, 106, 0.15);
        border-radius: 8px;
        border: 1px solid #555;
    }

    .pot-label {
        font-weight: bold;
        color: #6ac88a;
    }

    .pot-value {
        font-weight: bold;
        color: #fff;
        font-size: 1.2rem;
    }

    .actions-section {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .action-button {
        flex: 1;
        min-width: 150px;
    }
</style>

@using OpenHoldemEngine.Data
@using DataCard = OpenHoldemEngine.Data.Card

@if (Card is not null)
{
    <div class="playing-card" data-suit="@Card.CardSuit.ToString().ToLower()">
        <div class="card-content">
            <div class="card-rank">@FormatRank(Card.CardType)</div>
            <div class="card-suit">@GetSuitGlyph(Card.CardSuit)</div>
        </div>
    </div>
}

@code {
    /// <summary>The card to display, or null to display an empty slot.</summary>
    [Parameter]
    public DataCard? Card { get; set; }

    private static string FormatRank(CardType cardType)
    {
        return cardType switch
        {
            CardType.Ace => "A",
            CardType.Two => "2",
            CardType.Three => "3",
            CardType.Four => "4",
            CardType.Five => "5",
            CardType.Six => "6",
            CardType.Seven => "7",
            CardType.Eight => "8",
            CardType.Nine => "9",
            CardType.Ten => "T",
            CardType.Jack => "J",
            CardType.Queen => "Q",
            CardType.King => "K",
            _ => "?"
        };
    }

    private static string GetSuitGlyph(CardSuit suit)
    {
        return suit switch
        {
            CardSuit.Club => "♣",
            CardSuit.Diamond => "♦",
            CardSuit.Heart => "♥",
            CardSuit.Spade => "♠",
            _ => "?"
        };
    }
}

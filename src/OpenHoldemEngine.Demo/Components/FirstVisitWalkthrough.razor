@using AntDesign
@using OpenHoldemEngine.Demo.Services
@implements IAsyncDisposable
@inject BrowserStorage Storage
@inject WalkthroughState WalkthroughState

<Modal Visible="_visible"
    Title="Welcome to OpenHoldemEngine Demo"
    OkText="@OkLabel"
    OnOk="OnClose"
    CancelText="@CancelLabel"
    OnCancel="OnSkip"
    Width="600"
    Closable="true">
    <div class="walkthrough-content">
        @if (_currentStep == 1)
        {
            <div class="step-content">
                <h3>Step 1: The Poker Table</h3>
                <p>
                    On the left, you'll see a live poker table where you can:
                </p>
                <ul>
                    <li><strong>Play a hand:</strong> Click "Create and start game" to set up players, then use the action buttons to Fold, Check, Call, or Raise</li>
                    <li><strong>Watch the action:</strong> The table shows each player's cards, stack size, and current position (dealer, small blind, big blind)</li>
                    <li><strong>See the board:</strong> The community cards appear as you progress through the betting streets: flop, turn, river</li>
                    <li><strong>Track the pot:</strong> Both the current street pot and total pot are displayed</li>
                </ul>
                <p style="margin-top: 1rem; font-size: 0.9rem; color: #666;">
                    Or import a recorded hand history to replay past games step-by-step.
                </p>
            </div>
        }
        else if (_currentStep == 2)
        {
            <div class="step-content">
                <h3>Step 2: The Database Inspector</h3>
                <p>
                    The middle panel shows the <strong>physical SQLite database schema</strong> — the exact tables and rows the engine writes:
                </p>
                <ul>
                    <li><strong>Real tables:</strong> <code>Game</code>, <code>Hand</code>, <code>HandAction</code>, <code>HandDeckCard</code>, and more</li>
                    <li><strong>No in-memory game object:</strong> The engine has no internal state — the database IS the state</li>
                    <li><strong>See what changed:</strong> After each action, the inspector highlights tables whose row count changed</li>
                    <li><strong>Inspect values:</strong> Enums are stored as text, cards as two-character strings like <code>ah</code> (ace of hearts)</li>
                </ul>
                <p style="margin-top: 1rem; font-size: 0.9rem; color: #666;">
                    This teaches the central lesson: there is no hidden game state, only the database.
                </p>
            </div>
        }
        else if (_currentStep == 3)
        {
            <div class="step-content">
                <h3>Step 3: The Engine Calls Log</h3>
                <p>
                    The right panel shows the <strong>exact C# code</strong> that produced every table change:
                </p>
                <ul>
                    <li><strong>Readable snippets:</strong> Each action is shown as a C# call with named arguments and syntax highlighting</li>
                    <li><strong>Copy and paste:</strong> Take any snippet and use it directly in your own project</li>
                    <li><strong>Failed calls visible:</strong> If an action fails validation, you'll see the error instead of the result</li>
                    <li><strong>Whole session export:</strong> Copy the entire session's calls as a compilable console-project snippet</li>
                </ul>
                <p style="margin-top: 1rem; font-size: 0.9rem; color: #666;">
                    Now you understand what the engine does. Play a hand or import one to see these three panels move together.
                </p>
            </div>
        }
    </div>
</Modal>

<style>
    .walkthrough-content {
        padding: 1rem 0;
    }

    .step-content h3 {
        margin-top: 0;
        margin-bottom: 1rem;
        color: #1890ff;
    }

    .step-content p {
        margin: 0.5rem 0;
        line-height: 1.6;
    }

    .step-content ul {
        margin: 0.5rem 0;
        padding-left: 1.5rem;
    }

    .step-content li {
        margin: 0.5rem 0;
        line-height: 1.6;
    }

    .step-content code {
        background-color: #f0f0f0;
        padding: 0.2rem 0.4rem;
        border-radius: 2px;
        font-family: 'Courier New', monospace;
    }
</style>

@code {
    private bool _visible = false;
    private int _currentStep = 1;
    private const string WalkthroughDismissedKey = "ohe-demo-walkthrough-dismissed";

    private string OkLabel => _currentStep < 3 ? "Next" : "Done";
    private const string CancelLabel = "Skip";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var isDismissed = await Storage.GetFlagAsync(WalkthroughDismissedKey);
            _visible = !isDismissed;
        }
        catch
        {
            // If storage service fails, show the walkthrough
            _visible = true;
        }

        WalkthroughState.ShowRequested += Show;
    }

    /// <summary>
    /// Opens the walkthrough and resets it to step 1.
    /// </summary>
    /// <returns>A task representing the asynchronous operation.</returns>
    public async Task Show()
    {
        _currentStep = 1;
        _visible = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnClose()
    {
        if (_currentStep < 3)
        {
            _currentStep++;
        }
        else
        {
            _visible = false;
            try
            {
                await Storage.SetFlagAsync(WalkthroughDismissedKey, true);
            }
            catch
            {
                // Ignore storage errors
            }
        }
    }

    private async Task OnSkip()
    {
        _visible = false;
        try
        {
            await Storage.SetFlagAsync(WalkthroughDismissedKey, true);
        }
        catch
        {
            // Ignore storage errors
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        WalkthroughState.ShowRequested -= Show;
        await Task.CompletedTask;
    }
}

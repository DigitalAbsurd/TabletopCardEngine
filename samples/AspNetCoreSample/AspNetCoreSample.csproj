<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Generated only so that IDE0005 (unnecessary using) runs at build time; a sample needs no API docs. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- No PackageReference on purpose: nothing audits the notices for samples/ (see docs/task-run.md). -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\TabletopCardEngine.AspNetCore\TabletopCardEngine.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\TabletopCardEngine.Sqlite\TabletopCardEngine.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the tests use the internal top-level Program as WebApplicationFactory<Program>. -->
    <InternalsVisibleTo Include="TabletopCardEngine.AspNetCore.Tests" />
  </ItemGroup>

</Project>
